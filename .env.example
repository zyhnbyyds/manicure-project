NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
DATABASE_URL=mysql://root:root@127.0.0.1:3306/manicure
REDIS_URL=redis://127.0.0.1:6379
JWT_ISSUER=manicure
JWT_AUDIENCE=manicure-web
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-at-least-32-character-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=uploads
# 执行 `bun run db:seed` 时创建管理员（用户名 admin）所用的密码。
# ⚠️ 必填：`src/database/seed/index.ts` 读不到会直接抛错。
SEED_ADMIN_PASSWORD=
# Swagger 接口文档
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
SWAGGER_TITLE=美甲店管理系统 API
SWAGGER_DESCRIPTION=美甲店到店预约、会员、收银与经营管理 API
SWAGGER_VERSION=0.1.0
# AI Operations Layer
AI_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 小程序（未配置 AppID/Secret 时 app 域登录返回「小程序端未启用」）
WX_MINIAPP_APPID=
WX_MINIAPP_SECRET=
# 未拿到凭据时的开发/测试开关：true 走假微信实现（**生产环境强制失效**）
WX_MINIAPP_FAKE=false
# 微信支付 Native 扫码（微信支付；未配置时通道返回「未启用」）
WXPAY_APPID=
WXPAY_MCHID=
WXPAY_SERIAL_NO=
WXPAY_PRIVATE_KEY=
WXPAY_API_V3_KEY=
WXPAY_NOTIFY_URL=
# 可选：平台证书公钥（SPKI 公钥 PEM 或 X509 证书 PEM），配了免联网下载；**不参与通道启用判定**
WXPAY_PLATFORM_PUBLIC_KEY=
# 支付宝当面付（未配置时通道返回「未启用」）
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=
# 短信通道（none = 只写站内消息 + 失败日志，不阻塞业务）
SMS_PROVIDER=none
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
