NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
DATABASE_URL=mysql://root:root@127.0.0.1:3306/manicure
REDIS_URL=redis://127.0.0.1:6379
JWT_ISSUER=manicure
JWT_AUDIENCE=manicure-web
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-at-least-32-character-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGINS=http://localhost:9527
UPLOAD_DIR=uploads
# Swagger 接口文档
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
SWAGGER_TITLE=美甲店管理系统 API
SWAGGER_DESCRIPTION=美甲店到店预约、会员、收银与经营管理 API
SWAGGER_VERSION=0.1.0
# AI Operations Layer
AI_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 小程序（B6 预留，未配置时 app 域登录返回「小程序端未启用」）
WX_MINIAPP_APPID=
WX_MINIAPP_SECRET=
# 微信支付 Native 扫码（B3，未配置时通道返回「未启用」）
WXPAY_APPID=
WXPAY_MCHID=
WXPAY_SERIAL_NO=
WXPAY_PRIVATE_KEY=
WXPAY_API_V3_KEY=
WXPAY_NOTIFY_URL=
# 支付宝当面付（B3）
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=
# 短信通道（B5，none = 只写站内消息）
SMS_PROVIDER=none
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
