# ─────────────────────────────────────────────────────────────────────────
# Docker 部署变量模板
#
# 用法：复制成 deploy/.env 后按需修改（deploy/up.sh / up.ps1 会自动做这件事，
# 并填入随机密钥与随机管理员密码）。
#   ⚠️ deploy/.env 已被 .gitignore 忽略，不要提交。
#
# 这个文件同时承担两个角色：
#   1. `docker compose --env-file deploy/.env ...` —— 给 compose 做 ${} 插值
#      （MYSQL_ROOT_PASSWORD / MYSQL_DATABASE / WEB_PORT / TZ 属于这类）
#   2. compose 里的 `env_file:` —— 原样注入 api 容器作为业务配置
# ─────────────────────────────────────────────────────────────────────────

# ── 编排参数 ─────────────────────────────────────────────────────────────
# MySQL root 密码。**必填**，compose 里用了 `:?` 强校验
MYSQL_ROOT_PASSWORD=
# 库名（首次启动自动创建）
MYSQL_DATABASE=manicure
# 后台入口对外端口（80 被占用就改成 8080 之类）
WEB_PORT=80
# 时区。业务全部按店内本地日切分，除极端情况外不要改
TZ=Asia/Shanghai

# ── 应用基本配置 ─────────────────────────────────────────────────────────
NODE_ENV=production
# 容器内端口，healthcheck 按 3000 探活；改了要同步改 docker-compose.yml 里的健康检查
PORT=3000
API_PREFIX=api/v1

# ⚠️ 下面两行**不用改**：compose 会把它们覆盖成容器网络内的服务名
#    （mysql://root:xxx@db:3306/... 与 redis://redis:6379）
DATABASE_URL=mysql://root:placeholder@db:3306/manicure
REDIS_URL=redis://redis:6379

# 上传目录（相对路径，对应容器内 /app/uploads，已挂卷持久化）
UPLOAD_DIR=uploads

# ── 安全密钥（必填，up.sh / up.ps1 会自动填随机串） ──────────────────────
JWT_ISSUER=manicure
JWT_AUDIENCE=manicure-web
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# 允许跨域的来源。同源部署（前端经 nginx 反代 /api）时浏览器不会发跨域请求，
# 这里留空即可；若把前端单独部署到别的域名，填 `https://你的域名`
CORS_ORIGINS=

# ── 初始化 ───────────────────────────────────────────────────────────────
# 首次启动创建管理员（用户名 admin）用的密码。up.sh / up.ps1 会填随机值并在结尾打印。
# ⚠️ 库里已有 admin 时不会再使用它（避免每次重启重置密码）；
#    真要重置请把 SEED_ON_START 改成 force 再重启 api 容器。
SEED_ADMIN_PASSWORD=
# auto（默认）| force | false，语义见 deploy/api-entrypoint.sh
SEED_ON_START=auto

# ── 接口文档 ─────────────────────────────────────────────────────────────
# 对公网开放时建议改 false（文档会暴露全部接口路径）
SWAGGER_ENABLED=false
SWAGGER_PATH=docs
SWAGGER_TITLE=美甲店管理系统 API
SWAGGER_DESCRIPTION=美甲店到店预约、会员、收银与经营管理 API
SWAGGER_VERSION=1.0.0

# ── AI 助手（可选） ──────────────────────────────────────────────────────
AI_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── 微信小程序（可选） ───────────────────────────────────────────────────
# 未配置时 app 域登录返回「小程序端未启用」
WX_MINIAPP_APPID=
WX_MINIAPP_SECRET=
# 开发/测试用的假微信实现；**生产环境强制失效**
WX_MINIAPP_FAKE=false

# ── 微信支付 Native 扫码（可选） ─────────────────────────────────────────
# 未配置时该通道返回「未启用」。NOTIFY_URL 必须是公网 HTTPS 且能被微信访问到
WXPAY_APPID=
WXPAY_MCHID=
WXPAY_SERIAL_NO=
WXPAY_PRIVATE_KEY=
WXPAY_API_V3_KEY=
WXPAY_NOTIFY_URL=
WXPAY_PLATFORM_PUBLIC_KEY=

# ── 支付宝当面付（可选） ─────────────────────────────────────────────────
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=

# ── 短信通道（可选） ─────────────────────────────────────────────────────
# none = 只写站内消息与失败日志，不阻塞业务
SMS_PROVIDER=none
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
