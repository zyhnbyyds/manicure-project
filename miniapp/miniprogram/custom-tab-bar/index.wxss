/* 自定义 TabBar —— 对齐设计稿：白底 + 顶部一条淡描边 + 细线图标（不用 emoji） */
.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 12rpx 12rpx calc(12rpx + env(safe-area-inset-bottom));
  background: var(--c-card, #ffffff);
  border-top: 2rpx solid var(--c-border, #efe7e2);
}

.tabbar__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.tabbar__icon {
  width: 46rpx;
  height: 46rpx;
  transition: transform 0.18s ease;
}

.tabbar__label {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--c-text-weak, #b9b3ae);
  transition: color 0.18s ease;
}

/* 选中态：图标略上浮 + 文字变主色（设计稿即如此，不做背景块） */
.is-active .tabbar__icon {
  transform: translateY(-2rpx);
}

.is-active .tabbar__label {
  color: var(--c-primary, #b45f6b);
}
