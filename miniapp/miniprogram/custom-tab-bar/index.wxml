<view class="tabbar" style="{{themeStyle}}">
  <view
    wx:for="{{tabs}}"
    wx:key="pagePath"
    class="tabbar__item {{selected === index ? 'is-active' : ''}}"
    data-index="{{index}}"
    bindtap="onTap"
    hover-class="tabbar__item--press"
    hover-start-time="0"
    hover-stay-time="90"
  >
    <!--
      两态图标**同时渲染**、靠透明度交叉淡入：
      直接换 `src` 会让小程序重新解码 data-URI 图片，切换瞬间闪一下空白（原来的观感问题之一）。
    -->
    <view class="tabbar__icon-wrap">
      <image class="tabbar__icon tabbar__icon--idle" src="{{iconsIdle[item.icon]}}" mode="aspectFit" />
      <image class="tabbar__icon tabbar__icon--active" src="{{iconsActive[item.icon]}}" mode="aspectFit" />
    </view>
    <view class="tabbar__label">{{item.text}}</view>
  </view>
</view>
