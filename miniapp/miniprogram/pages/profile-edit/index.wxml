<view class="page" style="{{themeStyle}}">
  <view class="page-body profile-body">
    <!-- 未绑定：资料是个人档案，先引导而不是显示空表单 -->
    <view wx:if="{{needBind}}" class="empty anim-pop">
      <view class="empty__badge">
        <image class="empty__badge-icon" src="{{icons.person}}" mode="aspectFit" />
      </view>
      <view class="empty__text">绑定手机号后可以修改资料</view>
      <view class="empty__hint">资料跟着手机号走，绑定后才能把你的档案认出来</view>
      <view class="btn btn--primary empty__action" bindtap="onGuestLogin"
        >去绑定手机号</view
      >
    </view>

    <view wx:elif="{{loading}}" class="loading">正在读取你的资料…</view>

    <view wx:elif="{{errorText}}" class="empty anim-pop">
      <view class="empty__badge">
        <image class="empty__badge-icon" src="{{icons.person}}" mode="aspectFit" />
      </view>
      <view class="empty__text">{{errorText}}</view>
      <view class="empty__hint">请检查网络后重试</view>
      <view class="btn btn--primary btn--sm empty__action" bindtap="onRetry"
        >重新加载</view
      >
    </view>

    <block wx:else>
      <!-- 头像 + 昵称：设计稿的第一屏视觉重心 -->
      <view class="hero anim-rise">
        <view class="hero__avatar-wrap press-sm" bindtap="onAvatar">
          <image
            wx:if="{{avatarSrc}}"
            class="hero__avatar"
            src="{{avatarSrc}}"
            mode="aspectFill"
          />
          <view wx:else class="hero__avatar hero__avatar--text">{{avatarText}}</view>
          <view class="hero__camera">
            <view class="hero__camera-lens"></view>
          </view>
        </view>
        <view class="hero__nickname">
          <text class="hero__nickname-text ellipsis">{{nickname || name}}</text>
          <view class="hero__pencil press-sm" bindtap="onEditNickname">✎</view>
        </view>
      </view>

      <!--
        会员卡条：等级徽章 + 会员号 + 累计消费 + 升级进度。
        徽章材质与 `pages/member` 的卡面同源（`.tier-*` 变量在 app.wxss）。
      -->
      <view class="mstrip {{tierClass}} anim-rise">
        <view class="mstrip__badge">
          <view class="mstrip__gem"></view>
        </view>
        <view class="grow">
          <view class="mstrip__level">{{levelName}}</view>
          <view class="mstrip__no">{{memberNo}}</view>
          <view class="mstrip__spent">累计消费 {{totalSpentText}} 元</view>
          <view class="mstrip__bar">
            <view
              class="mstrip__bar-inner"
              style="width: {{progressPercent}}%"
            ></view>
          </view>
          <view class="mstrip__next">{{nextText}}</view>
        </view>
      </view>

      <!-- 基本信息 -->
      <view class="section">
        <view class="section__title">基本信息</view>
      </view>

      <view class="card">
        <!-- 昵称：写微信身份，不影响门店档案里的姓名 -->
        <view class="field">
          <view class="field__label">昵称</view>
          <input
            class="field__input"
            value="{{nickname}}"
            maxlength="50"
            placeholder="APP 里怎么称呼你"
            placeholder-class="field__placeholder"
            bindinput="onNicknameInput"
          />
        </view>

        <!-- 姓名：门店档案里的真实姓名（对账 / 排班要用） -->
        <view class="field">
          <view class="field__label">姓名</view>
          <input
            class="field__input"
            value="{{name}}"
            maxlength="30"
            placeholder="请输入真实姓名"
            placeholder-class="field__placeholder"
            bindinput="onNameInput"
          />
        </view>

        <!-- 性别：取值与后端同枚举，中文只作标签 -->
        <view class="field field--column">
          <view class="field__label">性别</view>
          <view class="genders">
            <view
              wx:for="{{genderOptions}}"
              wx:key="value"
              class="chip {{gender === item.value ? 'is-active' : ''}}"
              data-value="{{item.value}}"
              bindtap="onGender"
            >
              {{item.label}}
            </view>
          </view>
        </view>

        <!-- 生日：native picker，范围 1930-01-01 ~ 今天 -->
        <view class="field">
          <view class="field__label">生日</view>
          <picker
            mode="date"
            value="{{birthday}}"
            start="{{minBirthday}}"
            end="{{maxBirthday}}"
            bindchange="onBirthday"
          >
            <view class="field__picker {{birthday ? '' : 'is-empty'}}">
              {{birthdayText}}
            </view>
          </picker>
          <view wx:if="{{birthday}}" class="field__clear press-sm" bindtap="onBirthdayClear"
            >清空</view
          >
        </view>

        <!-- 美甲偏好：选项来自门店真实款式分类（不是写死的一串风格名） -->
        <view class="field field--last">
          <view class="field__label">美甲偏好</view>
          <picker
            range="{{preferenceOptions}}"
            bindchange="onPreference"
            disabled="{{preferenceOptions.length === 0}}"
          >
            <view class="field__picker {{preference ? '' : 'is-empty'}}">
              {{preference || '选择喜欢的风格'}}
            </view>
          </picker>
          <view wx:if="{{preference}}" class="field__clear press-sm" bindtap="onPreferenceClear"
            >清空</view
          >
        </view>
      </view>

      <!-- 账号与安全 -->
      <view class="section">
        <view class="section__title">账号与安全</view>
      </view>
      <view class="card">
        <view class="field" bindtap="onChangePhone">
          <view class="field__label">手机号</view>
          <view class="field__readonly">{{phoneMasked}}</view>
          <view class="field__tag">{{bound ? '已验证' : '未绑定'}}</view>
          <view class="field__arrow">›</view>
        </view>
        <view class="field field--last">
          <view class="field__label">微信绑定</view>
          <view class="field__readonly">{{bound ? '已绑定' : '未绑定'}}</view>
          <view class="field__tag field__tag--ok">{{bound ? '✓' : ''}}</view>
        </view>
      </view>
      <view class="hint"
        >手机号是账号凭据，预约、会员、券都跟着它，更换需要重新授权一次。</view
      >

      <view class="submit">
        <view
          class="btn btn--primary btn--block {{dirty && !saving ? '' : 'btn--disabled'}}"
          bindtap="onSave"
          >{{saving ? '保存中…' : '保存'}}</view
        >
      </view>
      <view class="safe-bottom"></view>
    </block>
  </view>
</view>
