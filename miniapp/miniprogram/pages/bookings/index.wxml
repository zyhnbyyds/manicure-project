<view class="page page-with-tabbar" style="{{themeStyle}}">
  <!--
    搜索 + 状态筛选：整块吸顶（列表一长就再也够不着筛选，见 app.wxss `.sticky-head`）。
    「我的预约」是 tab 页、底部有自定义 TabBar，所以头部的 sticky 只到 top: 0。
  -->
  <view class="head sticky-head">
    <!-- 搜索（batch1 第 1 屏：单号 / 项目 / 美甲师都能搜） -->
    <view class="search">
      <view class="search__box">
        <image class="search__icon" src="{{icons.search}}" mode="aspectFit" />
        <input
          class="search__input"
          value="{{keyword}}"
          placeholder="搜索单号、项目或美甲师"
          placeholder-class="search__placeholder"
          bindinput="onSearchInput"
        />
        <view wx:if="{{keyword}}" class="search__clear" bindtap="onSearchClear">×</view>
      </view>
    </view>

    <!-- 状态筛选 + 排序 -->
    <view class="filters">
      <scroll-view class="filters__scroll" scroll-x enable-flex show-scrollbar="{{false}}">
        <view class="filters__row">
          <view
            wx:for="{{filters}}"
            wx:key="key"
            class="chip {{activeFilter === item.key ? 'is-active' : ''}}"
            data-key="{{item.key}}"
            bindtap="onFilter"
          >
            {{item.label}}
          </view>
        </view>
      </scroll-view>
      <view class="filters__sort" bindtap="onFilterSort">
        <image class="filters__sort-icon" src="{{icons.funnel}}" mode="aspectFit" />
      </view>
    </view>
  </view>

  <view class="page-body">
    <!-- 未绑定：引导登录（未登录可浏览款式，但看不了「我的预约」） -->
    <view wx:if="{{guest}}" class="empty anim-pop">
      <view class="empty__badge">
        <image class="empty__badge-icon" src="{{icons.calendar}}" mode="aspectFit" />
      </view>
      <view class="empty__text">{{loggedIn ? '绑定手机号后查看预约' : '登录后查看你的预约'}}</view>
      <view class="empty__hint">预约记录跟着手机号走，绑定后就能看到全部订单</view>
      <view class="btn btn--primary empty__action" bindtap="onGuestLogin">去登录 / 绑定</view>
    </view>

    <view wx:elif="{{loading}}" class="loading">正在翻你的预约…</view>

    <!-- 网络失败态（batch3 第 3 屏） -->
    <view wx:elif="{{errorText}}" class="empty anim-pop">
      <view class="empty__badge">
        <image class="empty__badge-icon" src="{{icons.calendar}}" mode="aspectFit" />
      </view>
      <view class="empty__text">{{errorText}}</view>
      <view class="empty__hint">请检查网络后重试</view>
      <view class="btn btn--primary btn--sm empty__action" bindtap="onRetry">重新加载</view>
    </view>

    <!-- 空态（batch3 第 1 屏：暂无预约 + 去挑款式） -->
    <view wx:elif="{{bookings.length === 0}}" class="empty anim-pop">
      <view class="empty__badge">
        <image class="empty__badge-icon" src="{{icons.calendar}}" mode="aspectFit" />
      </view>
      <view class="empty__text">暂无预约</view>
      <view class="empty__hint">还没有预约记录，去挑一款喜欢的款式吧</view>
      <view class="btn btn--primary empty__action" bindtap="goServices">去挑款式</view>
    </view>

    <!--
      单列订单卡片（设计稿：状态胶囊 + 单号 / 左右两栏 / 底部操作）。
      卡片整体可点进详情，卡内按钮用 catchtap 阻止冒泡，避免「点取消却先跳了详情」。
    -->
    <view wx:else class="list anim-rise">
      <view
        wx:for="{{bookings}}"
        wx:key="id"
        class="card bcard press {{item.muted ? 'is-muted' : ''}}"
        data-id="{{item.id}}"
        bindtap="onDetail"
      >
        <!-- 头：状态胶囊 + 单号 -->
        <view class="bcard__head">
          <view class="bcard__status pill--{{item.tone}}">{{item.statusText}}</view>
          <view class="bcard__no">
            <text class="bcard__no-label">预约单号</text>
            <text class="bcard__no-value">{{item.bookingNo}}</text>
          </view>
        </view>

        <!-- 身：左（时间 + 美甲师）｜竖线｜右（项目 + 金额 + 资金状态） -->
        <view class="bcard__body">
          <view class="bcard__left">
            <view class="bcard__date">{{item.dateText}}</view>
            <view class="bcard__time">{{item.timeText}}</view>
            <view class="bcard__staff">
              <image
                class="bcard__staff-avatar"
                src="{{item.staffAvatarResolved}}"
                mode="aspectFill"
              />
              <text class="bcard__staff-name ellipsis">{{item.staffName}}</text>
            </view>
          </view>
          <view class="bcard__divider"></view>
          <view class="bcard__right">
            <view class="bcard__items ellipsis-2">{{item.itemNames}}</view>
            <view class="bcard__amount">¥{{item.payableText}}</view>
            <view class="bcard__pay {{item.paid ? 'is-paid' : ''}}">
              {{item.payStatusText}}
            </view>
            <!--
              已退金额必须单独露出来：部分退款时 `payStatus` 仍是 `paid`（规格如此），
              只显示「已结清」会让顾客以为钱没退（取消页还写着「可在我的预约查看进度」）。
            -->
            <view wx:if="{{item.hasRefund}}" class="bcard__refund">
              已退 ¥{{item.refundText}}
            </view>
          </view>
        </view>

        <!-- 底：结算方式 + 操作（主操作实心、次操作描边） -->
        <view class="bcard__foot">
          <view class="bcard__method">
            <image
              class="bcard__method-icon"
              src="{{icons.card}}"
              mode="aspectFit"
            />
            <text>到店支付</text>
          </view>
          <view class="bcard__actions">
            <view
              wx:if="{{(item.payStatus === 'unpaid' || item.payStatus === 'partial') && selfPayEnabled}}"
              class="mini-btn press-sm"
              data-id="{{item.id}}"
              catchtap="onPay"
            >
              去支付
            </view>
            <view
              wx:if="{{item.status === 'completed'}}"
              class="mini-btn mini-btn--ghost press-sm"
              data-id="{{item.id}}"
              catchtap="onRebook"
            >
              再次预约
            </view>
            <view
              wx:if="{{item.reviewable}}"
              class="mini-btn press-sm"
              data-id="{{item.id}}"
              catchtap="onReview"
            >
              去评价
            </view>
            <view
              wx:if="{{item.cancellable}}"
              class="mini-btn mini-btn--ghost press-sm"
              data-id="{{item.id}}"
              catchtap="onCancel"
            >
              取消预约
            </view>
            <view
              class="mini-btn press-sm"
              data-id="{{item.id}}"
              catchtap="onDetail"
            >
              查看详情
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
