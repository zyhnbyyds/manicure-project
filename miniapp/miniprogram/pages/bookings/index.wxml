<view class="page page-with-tabbar" style="{{themeStyle}}">
  <!-- 搜索（batch1 第 1 屏：单号 / 项目 / 美甲师都能搜） -->
  <view class="search">
    <view class="search__box">
      <image class="search__icon" src="{{icons.search}}" mode="aspectFit" />
      <input
        class="search__input"
        value="{{keyword}}"
        placeholder="搜索单号 / 项目 / 美甲师"
        placeholder-class="search__placeholder"
        bindinput="onSearchInput"
      />
      <view wx:if="{{keyword}}" class="search__clear" bindtap="onSearchClear">×</view>
    </view>
  </view>

  <!-- 状态筛选 + 排序 -->
  <view class="filters">
    <scroll-view class="filters__scroll" scroll-x enable-flex show-scrollbar="{{false}}">
      <view class="filters__row">
        <view
          wx:for="{{filters}}"
          wx:key="key"
          class="chip {{activeFilter === item.key ? 'is-active' : ''}}"
          data-key="{{item.key}}"
          bindtap="onFilter"
        >
          {{item.label}}
        </view>
      </view>
    </scroll-view>
    <view class="filters__sort" bindtap="onFilterSort">
      <image class="filters__sort-icon" src="{{icons.funnel}}" mode="aspectFit" />
    </view>
  </view>

  <view class="page-body">
    <!-- 未绑定：引导登录（未登录可浏览款式，但看不了「我的预约」） -->
    <view wx:if="{{guest}}" class="empty anim-pop">
      <view class="empty__badge">
        <image class="empty__badge-icon" src="{{icons.calendar}}" mode="aspectFit" />
      </view>
      <view class="empty__text">{{loggedIn ? '绑定手机号后查看预约' : '登录后查看你的预约'}}</view>
      <view class="empty__hint">预约记录跟着手机号走，绑定后就能看到全部订单</view>
      <view class="btn btn--primary empty__action" bindtap="onGuestLogin">去登录 / 绑定</view>
    </view>

    <view wx:elif="{{loading}}" class="loading">正在翻你的预约…</view>

    <!-- 网络失败态（batch3 第 3 屏） -->
    <view wx:elif="{{errorText}}" class="empty anim-pop">
      <view class="empty__badge">
        <image class="empty__badge-icon" src="{{icons.calendar}}" mode="aspectFit" />
      </view>
      <view class="empty__text">{{errorText}}</view>
      <view class="empty__hint">请检查网络后重试</view>
      <view class="btn btn--primary btn--sm empty__action" bindtap="onRetry">重新加载</view>
    </view>

    <!-- 空态（batch3 第 1 屏：暂无预约 + 去挑款式） -->
    <view wx:elif="{{bookings.length === 0}}" class="empty anim-pop">
      <view class="empty__badge">
        <image class="empty__badge-icon" src="{{icons.calendar}}" mode="aspectFit" />
      </view>
      <view class="empty__text">暂无预约</view>
      <view class="empty__hint">还没有预约记录，去挑一款喜欢的款式吧</view>
      <view class="btn btn--primary empty__action" bindtap="goServices">去挑款式</view>
    </view>

    <!-- 双列订单卡片（batch1 第 1 屏）：卡片可点进详情，卡内按钮用 catchtap 阻止冒泡 -->
    <view wx:else class="grid anim-rise">
      <view
        wx:for="{{bookings}}"
        wx:key="id"
        class="card bcard press"
        data-id="{{item.id}}"
        bindtap="onDetail"
      >
        <view class="bcard__status pill--{{item.tone}}">{{item.statusText}}</view>
        <view class="bcard__no">预约单号</view>
        <view class="bcard__no-value ellipsis">{{item.bookingNo}}</view>
        <view class="bcard__when">{{item.dateText}} {{item.timeText}}</view>
        <view class="bcard__staff ellipsis">
          <image class="bcard__staff-avatar" src="{{item.staffAvatarResolved}}" mode="aspectFill" />
          {{item.staffName}}
        </view>
        <view class="bcard__items ellipsis-2">{{item.itemNames}}</view>
        <view class="bcard__foot">
          <view class="bcard__amount">¥{{item.payableText}}</view>
          <view class="bcard__pay">{{item.payStatusText}}</view>
        </view>
        <view class="bcard__actions">
          <view
            wx:if="{{(item.payStatus === 'unpaid' || item.payStatus === 'partial') && selfPayEnabled}}"
            class="mini-btn press-sm"
            data-id="{{item.id}}"
            catchtap="onPay"
          >
            去支付
          </view>
          <!-- 未付清但小程序内自助支付未开放：只提示去路，不给点进去是死路的按钮 -->
          <view
            wx:if="{{(item.payStatus === 'unpaid' || item.payStatus === 'partial') && !selfPayEnabled}}"
            class="bcard__pay-store"
          >
            到店支付
          </view>
          <view
            wx:if="{{item.reviewable}}"
            class="mini-btn press-sm"
            data-id="{{item.id}}"
            catchtap="onReview"
          >
            去评价
          </view>
          <view
            wx:if="{{item.cancellable}}"
            class="mini-btn mini-btn--ghost press-sm"
            data-id="{{item.id}}"
            catchtap="onCancel"
          >
            取消预约
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
