/* 我的预约 —— 严格对齐 docs/manicure-ui-batch1 第 1 屏（含 batch3 空态/网络失败） */

/* ── 搜索与筛选 ───────────────────────────────────────────── */

.search {
  padding: 12rpx 28rpx 0;
}

.search__box {
  display: flex;
  align-items: center;
  height: 72rpx;
  padding: 0 26rpx;
  background: var(--c-card);
  border-radius: var(--r-pill);
}

.search__icon {
  width: 30rpx;
  height: 30rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.search__input {
  flex: 1;
  min-width: 0;
  font-size: 25rpx;
  color: var(--c-text);
}

.search__placeholder {
  color: var(--c-text-weak);
  font-size: 25rpx;
}

.search__clear {
  width: 40rpx;
  text-align: center;
  font-size: 34rpx;
  line-height: 1;
  color: var(--c-text-weak);
}

.filters {
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx 8rpx;
}

.filters__scroll {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}

.filters__row {
  display: flex;
}

.chip {
  flex-shrink: 0;
  height: 58rpx;
  line-height: 58rpx;
  padding: 0 26rpx;
  margin-right: 14rpx;
  border-radius: var(--r-pill);
  background: var(--c-card);
  color: var(--c-text-sub);
  font-size: 25rpx;
}

.chip.is-active {
  background: var(--c-primary);
  color: var(--c-on-primary);
}

.filters__sort {
  width: 56rpx;
  height: 56rpx;
  margin-left: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.filters__sort-icon {
  width: 36rpx;
  height: 36rpx;
}

/* ── 双列网格 ─────────────────────────────────────────────── */

.grid {
  display: flex;
  flex-wrap: wrap;
}

.bcard {
  width: 48%;
  margin-bottom: 20rpx;
  padding: 20rpx;
}

/* 用 margin 而非 flex gap：iOS 老版本 WKWebView 不支持 gap */
.bcard:nth-child(odd) {
  margin-right: 4%;
}

/* 状态胶囊：低饱和语义色，颜色仍走主题令牌 */
.bcard__status {
  display: inline-flex;
  align-items: center;
  height: 38rpx;
  padding: 0 16rpx;
  border-radius: var(--r-pill);
  font-size: 20rpx;
  background: var(--c-primary-soft);
  color: var(--c-primary-deep);
}

.pill--waiting {
  background: var(--c-chip);
  color: var(--c-text-sub);
}

.pill--done {
  background: var(--c-bg);
  color: var(--c-text-sub);
}

.pill--cancelled {
  background: var(--c-bg);
  color: var(--c-text-weak);
}

.bcard__no {
  margin-top: 16rpx;
  font-size: 19rpx;
  color: var(--c-text-weak);
}

.bcard__no-value {
  margin-top: 2rpx;
  font-size: 22rpx;
  color: var(--c-text-sub);
}

.bcard__when {
  margin-top: 10rpx;
  font-family: var(--font-serif);
  font-size: 26rpx;
  font-weight: 600;
}

.bcard__staff {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--c-text-sub);
}

.bcard__items {
  margin-top: 6rpx;
  font-size: 21rpx;
  line-height: 1.45;
  color: var(--c-text-weak);
}

.bcard__foot {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 14rpx;
}

.bcard__amount {
  font-family: var(--font-serif);
  font-size: 30rpx;
  font-weight: 600;
  color: var(--c-primary);
}

.bcard__pay {
  font-size: 19rpx;
  color: var(--c-text-weak);
}

.bcard__actions {
  display: flex;
  flex-wrap: wrap;
  margin-top: 14rpx;
}

.mini-btn {
  height: 52rpx;
  line-height: 52rpx;
  padding: 0 20rpx;
  margin: 8rpx 10rpx 0 0;
  border-radius: var(--r-pill);
  background: var(--c-primary);
  color: var(--c-on-primary);
  font-size: 21rpx;
}

.mini-btn--ghost {
  background: transparent;
  border: 2rpx solid var(--c-primary);
  color: var(--c-primary);
  line-height: 48rpx;
}

/* ── 空态 / 失败态 ────────────────────────────────────────── */

.empty__badge {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 28rpx;
  border-radius: 50%;
  background: var(--c-chip);
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty__badge-icon {
  width: 72rpx;
  height: 72rpx;
  opacity: 0.55;
}

.empty__action {
  margin-top: 32rpx;
}
