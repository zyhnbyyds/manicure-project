<view class="page card-page" style="{{themeStyle}}">
  <!-- 未绑定手机号：这是正常状态，不是错误 -->
  <view wx:if="{{needBind}}" class="page-body">
    <view class="bind">
      <view class="bind__title">绑定手机号，解锁会员卡</view>
      <view class="bind__text">
        绑定后可以看到你的等级折扣、储值余额、积分与次卡，也方便到店联系你。
      </view>
      <button
        class="btn btn--primary btn--block bind__btn"
        open-type="getPhoneNumber"
        bindgetphonenumber="onGetPhone"
      >
        授权手机号
      </button>
    </view>
  </view>

  <view wx:elif="{{loading}}" class="loading">正在读取会员信息…</view>

  <view wx:elif="{{errorText}}" class="empty">
    <view class="empty__text">{{errorText}}</view>
    <view class="btn btn--primary btn--sm empty__action" bindtap="onRetry">重新加载</view>
  </view>

  <block wx:else>
    <view class="page-body card-body">
      <!-- 会员卡：渐变卡面 + 装饰圆 + M 水印 -->
      <view class="mcard">
        <view class="mcard__circle mcard__circle--a"></view>
        <view class="mcard__circle mcard__circle--b"></view>
        <view class="mcard__mark">M</view>
        <view class="mcard__brand">美甲小铺</view>
        <view class="mcard__title">会员卡</view>
        <view class="mcard__slogan">专属美甲 · 尊享品质</view>
        <view class="mcard__foot">
          <view class="mcard__no">{{cardNo}}</view>
          <view class="mcard__level">{{levelName}}</view>
        </view>
      </view>

      <!-- 资产三列（余额/积分/次卡） -->
      <view class="assets">
        <view class="assets__item" bindtap="onRecharge">
          <view class="assets__value">{{balanceText}}</view>
          <view class="assets__label">储值余额</view>
        </view>
        <view class="assets__item" bindtap="onPoints">
          <view class="assets__value">{{points}}</view>
          <view class="assets__label">可用积分</view>
        </view>
        <view class="assets__item" bindtap="onCards">
          <view class="assets__value">{{cardCount}}</view>
          <view class="assets__label">有效次卡</view>
        </view>
      </view>
      <view class="assets__split">
        本金 {{principalText}} 元 · 赠送 {{bonusText}} 元（赠送不可退）
      </view>

      <!-- 会员权益 -->
      <view class="section">
        <view class="section__title">会员权益</view>
      </view>
      <view class="card benefits">
        <view
          wx:for="{{benefits}}"
          wx:key="key"
          class="benefits__item"
          data-key="{{item.key}}"
          bindtap="onBenefit"
        >
          <image class="benefits__icon" src="{{icons[item.icon]}}" mode="aspectFit" />
          <view class="benefits__label">{{item.label}}</view>
          <view class="benefits__sub">{{item.key === 'discount' ? discountText : item.sub}}</view>
        </view>
      </view>

      <!-- 会员专享活动 -->
      <view class="section">
        <view class="section__title">会员专享活动</view>
      </view>
      <view class="card promo">
        <view class="grow">
          <view class="promo__title">新客专享</view>
          <view class="promo__sub">首次到店立减 ¥30</view>
          <view wx:if="{{offerId}}" class="btn btn--primary btn--sm promo__btn" bindtap="onClaim">立即领取</view>
        </view>
        <image class="promo__photo" src="{{promoImage}}" mode="aspectFill" />
      </view>
    </view>
  </block>
</view>
