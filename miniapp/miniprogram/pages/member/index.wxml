<view class="page" style="{{themeStyle}}">
  <view class="page-body">
    <!-- 未绑定手机号：这是正常状态，不是错误 -->
    <view wx:if="{{needBind}}" class="card card--tint bind">
      <view class="bind__emoji">🎀</view>
      <view class="bind__title">绑定手机号，解锁会员权益</view>
      <view class="bind__text">
        绑定后可以看到你的等级折扣、储值余额、积分与次卡，也方便到店联系你。
      </view>
      <button
        class="btn btn--primary btn--block bind__btn"
        open-type="getPhoneNumber"
        bindgetphonenumber="onGetPhone"
      >
        授权手机号
      </button>
    </view>

    <block wx:else>
      <view wx:if="{{loading}}" class="loading">正在读取会员信息…</view>

      <view wx:elif="{{errorText}}" class="empty">
        <view class="empty__emoji">🥺</view>
        <view class="empty__text">{{errorText}}</view>
      </view>

      <block wx:elif="{{me}}">
        <!-- 会员卡头 -->
        <view class="card hero">
          <view class="bubble hero__bubble"></view>
          <view class="hero__row">
            <view class="hero__avatar">🐱</view>
            <view class="grow">
              <view class="hero__name">{{me.name}}</view>
              <view class="hero__phone">{{me.phoneText}}</view>
            </view>
            <view class="hero__level">{{me.levelName}}</view>
          </view>
          <view class="hero__stats">
            <view class="hero__stat">
              <view class="hero__stat-value">{{me.discountText}}</view>
              <view class="hero__stat-label">会员折扣</view>
            </view>
            <view class="hero__stat">
              <view class="hero__stat-value">{{me.points}}</view>
              <view class="hero__stat-label">可用积分</view>
            </view>
            <view class="hero__stat">
              <view class="hero__stat-value">{{me.activeCardCount}}</view>
              <view class="hero__stat-label">有效次卡</view>
            </view>
          </view>
        </view>

        <!-- 储值余额：本金与赠送分列 -->
        <view class="card">
          <view class="section__title">储值余额</view>
          <view class="balance">
            <text class="price__symbol">¥</text>
            <text class="balance__yuan">{{me.balanceYuan}}</text>
          </view>
          <view class="balance__split">
            <view class="balance__cell">
              <view class="balance__cell-value">¥{{me.balancePrincipalYuan}}</view>
              <view class="balance__cell-label">本金（可退）</view>
            </view>
            <view class="balance__cell">
              <view class="balance__cell-value">¥{{me.balanceBonusYuan}}</view>
              <view class="balance__cell-label">赠送（不可退）</view>
            </view>
          </view>
        </view>

        <!-- 次卡 -->
        <view class="section">
          <view class="section__title">我的次卡</view>
        </view>
        <view wx:if="{{me.cards.length === 0}}" class="empty empty--compact">
          <view class="empty__emoji">🎫</view>
          <view class="empty__text">还没有次卡</view>
          <view class="empty__hint">到店可以咨询办卡，做几次更划算</view>
        </view>
        <view
          wx:for="{{me.cards}}"
          wx:key="id"
          class="card card-item {{item.statusKey !== 'active' ? 'is-dim' : ''}}"
        >
          <view class="row-between">
            <view class="card-item__name">{{item.cardName}}</view>
            <view class="tag {{item.statusKey === 'active' ? '' : 'tag--outline'}}">
              {{item.statusText}}
            </view>
          </view>
          <view class="card-item__no">卡号 {{item.cardNo}}</view>
          <view class="card-item__bar">
            <view class="card-item__bar-inner" style="width: {{item.percent}}%"></view>
          </view>
          <view class="row-between card-item__foot">
            <view class="text-weak">{{item.expireText}}</view>
            <view class="card-item__remain">
              剩余 <text class="card-item__times">{{item.remainTimes}}</text> / {{item.totalTimes}} 次
            </view>
          </view>
        </view>
      </block>
    </block>
    <view class="safe-bottom"></view>
  </view>
</view>
