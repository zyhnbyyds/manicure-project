/* 会员卡 —— 对齐 docs/design.png 第 6 屏，并按等级分档换肤（见文件下半部分的 tier-*） */

.card-body {
  padding-bottom: 60rpx;
}

/* ── 卡面 ─────────────────────────────────────────────────── */
/* `.mcard` 本体与四档皮肤统一定义在文件下半部分「分等级皮肤」一节 */

/* 装饰圆：设计稿右上有一个大的浅色圆、左下有一个小的（颜色随档次走 --mc-orb） */
.mcard__circle {
  position: absolute;
  border-radius: 50%;
  background: var(--mc-orb);
}

.mcard__circle--a {
  width: 260rpx;
  height: 260rpx;
  top: -90rpx;
  right: -60rpx;
}

.mcard__circle--b {
  width: 120rpx;
  height: 120rpx;
  bottom: -40rpx;
  left: -30rpx;
}

/* 「M」水印 */
.mcard__mark {
  position: absolute;
  right: 40rpx;
  top: 40rpx;
  font-family: var(--font-serif);
  font-size: 120rpx;
  line-height: 1;
  color: var(--mc-orb);
}

.mcard__brand {
  position: relative;
  font-size: 21rpx;
  letter-spacing: 4rpx;
  color: var(--mc-ink-soft);
}

.mcard__title {
  position: relative;
  margin-top: 14rpx;
  font-family: var(--font-serif);
  font-size: 56rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.mcard__slogan {
  position: relative;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--mc-ink-soft);
}

.mcard__foot {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 52rpx;
}

.mcard__no {
  font-size: 23rpx;
  letter-spacing: 2rpx;
  color: var(--mc-ink-soft);
}

/* 持卡人（右下角） */
.mcard__owner {
  font-size: 22rpx;
  letter-spacing: 1rpx;
  color: var(--mc-ink-soft);
}

/* ── 分等级皮肤 ──
 *
 * 四档的颜色变量（`.tier-0` ~ `.tier-3`）已经**提到 `app.wxss`**：
 * 「个人资料」页的等级徽章要用同一套材质，放在这里页面级 CSS 是拿不到的。
 * 本页只保留「卡面怎么用这些变量」的部分。
 */

/* 卡面本体：颜色全部走 `--mc-*` 变量，所以四档只需换 class */
.mcard {
  position: relative;
  overflow: hidden;
  padding: 36rpx 32rpx 30rpx;
  border-radius: var(--r-lg);
  background: var(--mc-bg);
  border: 2rpx solid var(--mc-line);
  box-shadow:
    0 14rpx 36rpx rgba(45, 34, 30, 0.16),
    inset 0 0 0 2rpx var(--mc-emboss);
  color: var(--mc-ink);
  transition: box-shadow 0.25s ease;
}

/* 箔光：一条斜向高光缓慢扫过，静止时几乎看不出，动起来才有"金属"感 */
.mcard__sheen {
  position: absolute;
  top: -40%;
  left: -60%;
  width: 60%;
  height: 180%;
  background: linear-gradient(
    100deg,
    rgba(255, 255, 255, 0) 0%,
    rgba(255, 255, 255, 0.42) 50%,
    rgba(255, 255, 255, 0) 100%
  );
  transform: rotate(8deg);
  animation: mcard-sheen 7s ease-in-out infinite;
  pointer-events: none;
}

@keyframes mcard-sheen {
  0%,
  62% {
    left: -60%;
  }

  86%,
  100% {
    left: 130%;
  }
}

/* 等级徽章：金属描边 + 菱形宝石点 + 衬线宽字距 */
.mcard__badge {
  position: relative;
  display: inline-flex;
  align-items: center;
  margin-top: 18rpx;
  padding: 0 20rpx;
  height: 44rpx;
  border-radius: var(--r-pill);
  background: var(--mc-badge-bg);
  border: 2rpx solid var(--mc-line);
}

.mcard__badge-gem {
  width: 12rpx;
  height: 12rpx;
  margin-right: 10rpx;
  background: var(--mc-gem);
  transform: rotate(45deg);
}

.mcard__badge-text {
  font-family: var(--font-serif);
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
  color: var(--mc-badge-ink);
}

/* ── 资产三列 ─────────────────────────────────────────────── */

.assets {
  display: flex;
  margin-top: 32rpx;
}

.assets__item {
  flex: 1;
  text-align: center;
}

.assets__value {
  font-family: var(--font-serif);
  font-size: 40rpx;
  font-weight: 600;
}

.assets__label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--c-text-weak);
}

.assets__split {
  margin-top: 14rpx;
  text-align: center;
  font-size: 21rpx;
  color: var(--c-text-weak);
}

/* ── 权益 ─────────────────────────────────────────────────── */

.benefits {
  display: flex;
  padding: 30rpx 0;
}

.benefits__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.benefits__icon {
  width: 48rpx;
  height: 48rpx;
}

.benefits__label {
  margin-top: 14rpx;
  font-size: 23rpx;
}

.benefits__sub {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--c-text-weak);
  text-align: center;
}

/* ── 活动 ─────────────────────────────────────────────────── */

.promo {
  display: flex;
  align-items: center;
  padding: 24rpx;
}

.promo__title {
  font-family: var(--font-serif);
  font-size: 32rpx;
  font-weight: 600;
}

.promo__sub {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--c-text-sub);
}

.promo__btn {
  width: 200rpx;
  margin-top: 20rpx;
}

.promo__photo {
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--r-md);
  margin-left: 20rpx;
  flex-shrink: 0;
}

/* ── 绑定引导 ─────────────────────────────────────────────── */

.bind {
  margin-top: 40rpx;
  padding: 48rpx 36rpx;
  background: var(--c-card);
  border-radius: var(--r-lg);
  text-align: center;
}

.bind__title {
  font-family: var(--font-serif);
  font-size: 36rpx;
  font-weight: 600;
}

.bind__text {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--c-text-sub);
}

.bind__btn {
  margin-top: 32rpx;
  line-height: 88rpx;
  border: none;
}

.bind__btn::after {
  border: none;
}
