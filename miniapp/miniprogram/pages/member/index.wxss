/* 会员卡 —— 对齐 docs/design.png 第 6 屏，并按等级分档换肤（见文件下半部分的 tier-*） */

.card-body {
  padding-bottom: 60rpx;
}

/* ── 卡面 ─────────────────────────────────────────────────── */
/* `.mcard` 本体与四档皮肤统一定义在文件下半部分「分等级皮肤」一节 */

/* 装饰圆：设计稿右上有一个大的浅色圆、左下有一个小的（颜色随档次走 --mc-orb） */
.mcard__circle {
  position: absolute;
  border-radius: 50%;
  background: var(--mc-orb);
}

.mcard__circle--a {
  width: 260rpx;
  height: 260rpx;
  top: -90rpx;
  right: -60rpx;
}

.mcard__circle--b {
  width: 120rpx;
  height: 120rpx;
  bottom: -40rpx;
  left: -30rpx;
}

/* 「M」水印 */
.mcard__mark {
  position: absolute;
  right: 40rpx;
  top: 40rpx;
  font-family: var(--font-serif);
  font-size: 120rpx;
  line-height: 1;
  color: var(--mc-orb);
}

.mcard__brand {
  position: relative;
  font-size: 21rpx;
  letter-spacing: 4rpx;
  color: var(--mc-ink-soft);
}

.mcard__title {
  position: relative;
  margin-top: 14rpx;
  font-family: var(--font-serif);
  font-size: 56rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.mcard__slogan {
  position: relative;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--mc-ink-soft);
}

.mcard__foot {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 52rpx;
}

.mcard__no {
  font-size: 23rpx;
  letter-spacing: 2rpx;
  color: var(--mc-ink-soft);
}

/* 持卡人（右下角） */
.mcard__owner {
  font-size: 22rpx;
  letter-spacing: 1rpx;
  color: var(--mc-ink-soft);
}

/* ── 分等级皮肤（tier-0 银 / tier-1 金 / tier-2 钻 / tier-3 曜石黑金） ──
 *
 * 一档一组变量，全部只在 `.mcard` 上用：底色渐变、主文字色、弱文字色、
 * 金属描边、装饰圆颜色、徽章面色与徽章文字色。
 *
 * 档次由服务端 `levelRank`（0 = 最低）决定，**不靠等级名判断** ——
 * 等级名是门店自己起的。门店加第 5、第 6 个等级时会停在最高档（tier-3），
 * 不会掉回银卡。
 *
 * 高贵感来自四处细节，四档都一样，只是材质不同：
 * 1. 135° 三段渐变（暗—亮—暗，模拟金属受光）；
 * 2. 2rpx 金属细线描边 + 内侧 1rpx 高光（压印感）；
 * 3. `.mcard__sheen` 缓慢扫过的箔光；
 * 4. 等级徽章 + 菱形宝石点（衬线字 + 宽字距）。
 */

/* 银：冷银灰，浅底深字 */
.mcard.tier-0 {
  --mc-bg: linear-gradient(135deg, #f2f4f7 0%, #dfe4ec 42%, #c3cad6 100%);
  --mc-ink: #3f4653;
  --mc-ink-soft: rgba(63, 70, 83, 0.62);
  --mc-line: rgba(255, 255, 255, 0.9);
  --mc-orb: rgba(255, 255, 255, 0.5);
  --mc-emboss: rgba(255, 255, 255, 0.55);
  --mc-badge-bg: rgba(255, 255, 255, 0.72);
  --mc-badge-ink: #4b5361;
  --mc-gem: linear-gradient(135deg, #eef1f6, #aab3c2);
}

/* 金：香槟金，暖底深棕字 */
.mcard.tier-1 {
  --mc-bg: linear-gradient(135deg, #fdf5e2 0%, #f0d9a8 42%, #d9b473 100%);
  --mc-ink: #5b4526;
  --mc-ink-soft: rgba(91, 69, 38, 0.62);
  --mc-line: rgba(255, 250, 235, 0.92);
  --mc-orb: rgba(255, 255, 255, 0.55);
  --mc-emboss: rgba(255, 255, 255, 0.6);
  --mc-badge-bg: rgba(255, 252, 244, 0.78);
  --mc-badge-ink: #8a6a2f;
  --mc-gem: linear-gradient(135deg, #fff6dd, #c79a4a);
}

/* 钻：冷调深蓝，深底浅字 + 冷钻光 */
.mcard.tier-2 {
  --mc-bg: linear-gradient(135deg, #414c66 0%, #262f43 45%, #141a27 100%);
  --mc-ink: #f3f1ec;
  --mc-ink-soft: rgba(243, 241, 236, 0.72);
  --mc-line: rgba(190, 214, 240, 0.5);
  --mc-orb: rgba(255, 255, 255, 0.16);
  --mc-emboss: rgba(255, 255, 255, 0.18);
  --mc-badge-bg: rgba(255, 255, 255, 0.14);
  --mc-badge-ink: #dbe8f7;
  --mc-gem: linear-gradient(135deg, #ffffff, #9fc4e6);
}

/* 曜石黑金：最深一档，黑底金线（门店再往上加等级就用这档） */
.mcard.tier-3 {
  --mc-bg: linear-gradient(135deg, #2a2a2e 0%, #16161a 45%, #0a0a0c 100%);
  --mc-ink: #f6ecd6;
  --mc-ink-soft: rgba(246, 236, 214, 0.7);
  --mc-line: rgba(212, 175, 106, 0.55);
  --mc-orb: rgba(212, 175, 106, 0.14);
  --mc-emboss: rgba(255, 255, 255, 0.12);
  --mc-badge-bg: rgba(212, 175, 106, 0.16);
  --mc-badge-ink: #e8cf9b;
  --mc-gem: linear-gradient(135deg, #ffeec2, #b8912f);
}

/* 卡面本体：颜色全部走上面那组变量，所以四档只需换 class */
.mcard {
  position: relative;
  overflow: hidden;
  padding: 36rpx 32rpx 30rpx;
  border-radius: var(--r-lg);
  background: var(--mc-bg);
  border: 2rpx solid var(--mc-line);
  box-shadow:
    0 14rpx 36rpx rgba(45, 34, 30, 0.16),
    inset 0 0 0 2rpx var(--mc-emboss);
  color: var(--mc-ink);
  transition: box-shadow 0.25s ease;
}

/* 箔光：一条斜向高光缓慢扫过，静止时几乎看不出，动起来才有"金属"感 */
.mcard__sheen {
  position: absolute;
  top: -40%;
  left: -60%;
  width: 60%;
  height: 180%;
  background: linear-gradient(
    100deg,
    rgba(255, 255, 255, 0) 0%,
    rgba(255, 255, 255, 0.42) 50%,
    rgba(255, 255, 255, 0) 100%
  );
  transform: rotate(8deg);
  animation: mcard-sheen 7s ease-in-out infinite;
  pointer-events: none;
}

@keyframes mcard-sheen {
  0%,
  62% {
    left: -60%;
  }

  86%,
  100% {
    left: 130%;
  }
}

/* 等级徽章：金属描边 + 菱形宝石点 + 衬线宽字距 */
.mcard__badge {
  position: relative;
  display: inline-flex;
  align-items: center;
  margin-top: 18rpx;
  padding: 0 20rpx;
  height: 44rpx;
  border-radius: var(--r-pill);
  background: var(--mc-badge-bg);
  border: 2rpx solid var(--mc-line);
}

.mcard__badge-gem {
  width: 12rpx;
  height: 12rpx;
  margin-right: 10rpx;
  background: var(--mc-gem);
  transform: rotate(45deg);
}

.mcard__badge-text {
  font-family: var(--font-serif);
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
  color: var(--mc-badge-ink);
}

/* ── 资产三列 ─────────────────────────────────────────────── */

.assets {
  display: flex;
  margin-top: 32rpx;
}

.assets__item {
  flex: 1;
  text-align: center;
}

.assets__value {
  font-family: var(--font-serif);
  font-size: 40rpx;
  font-weight: 600;
}

.assets__label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--c-text-weak);
}

.assets__split {
  margin-top: 14rpx;
  text-align: center;
  font-size: 21rpx;
  color: var(--c-text-weak);
}

/* ── 权益 ─────────────────────────────────────────────────── */

.benefits {
  display: flex;
  padding: 30rpx 0;
}

.benefits__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.benefits__icon {
  width: 48rpx;
  height: 48rpx;
}

.benefits__label {
  margin-top: 14rpx;
  font-size: 23rpx;
}

.benefits__sub {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--c-text-weak);
  text-align: center;
}

/* ── 活动 ─────────────────────────────────────────────────── */

.promo {
  display: flex;
  align-items: center;
  padding: 24rpx;
}

.promo__title {
  font-family: var(--font-serif);
  font-size: 32rpx;
  font-weight: 600;
}

.promo__sub {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--c-text-sub);
}

.promo__btn {
  width: 200rpx;
  margin-top: 20rpx;
}

.promo__photo {
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--r-md);
  margin-left: 20rpx;
  flex-shrink: 0;
}

/* ── 绑定引导 ─────────────────────────────────────────────── */

.bind {
  margin-top: 40rpx;
  padding: 48rpx 36rpx;
  background: var(--c-card);
  border-radius: var(--r-lg);
  text-align: center;
}

.bind__title {
  font-family: var(--font-serif);
  font-size: 36rpx;
  font-weight: 600;
}

.bind__text {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--c-text-sub);
}

.bind__btn {
  margin-top: 32rpx;
  line-height: 88rpx;
  border: none;
}

.bind__btn::after {
  border: none;
}

