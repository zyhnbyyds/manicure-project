/* 会员卡 —— 对齐 docs/design.png 第 6 屏 */

.card-body {
  padding-bottom: 60rpx;
}

/* ── 卡面 ─────────────────────────────────────────────────── */

.mcard {
  position: relative;
  overflow: hidden;
  padding: 36rpx 32rpx 30rpx;
  border-radius: var(--r-lg);
  background: var(--c-gradient);
}

/* 装饰圆：设计稿右上有一个大的浅色圆、左下有一个小的 */
.mcard__circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.45);
}

.mcard__circle--a {
  width: 260rpx;
  height: 260rpx;
  top: -90rpx;
  right: -60rpx;
}

.mcard__circle--b {
  width: 120rpx;
  height: 120rpx;
  bottom: -40rpx;
  left: -30rpx;
}

/* 「M」水印 */
.mcard__mark {
  position: absolute;
  right: 40rpx;
  top: 40rpx;
  font-family: var(--font-serif);
  font-size: 120rpx;
  line-height: 1;
  color: rgba(255, 255, 255, 0.55);
}

.mcard__brand {
  position: relative;
  font-size: 21rpx;
  letter-spacing: 4rpx;
  color: var(--c-text-sub);
}

.mcard__title {
  position: relative;
  margin-top: 14rpx;
  font-family: var(--font-serif);
  font-size: 56rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.mcard__slogan {
  position: relative;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--c-text-sub);
}

.mcard__foot {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 52rpx;
}

.mcard__no {
  font-size: 23rpx;
  letter-spacing: 2rpx;
  color: var(--c-text-sub);
}

.mcard__level {
  height: 40rpx;
  line-height: 40rpx;
  padding: 0 18rpx;
  border-radius: var(--r-pill);
  background: rgba(255, 255, 255, 0.7);
  color: var(--c-primary-deep);
  font-size: 20rpx;
}

/* ── 资产三列 ─────────────────────────────────────────────── */

.assets {
  display: flex;
  margin-top: 32rpx;
}

.assets__item {
  flex: 1;
  text-align: center;
}

.assets__value {
  font-family: var(--font-serif);
  font-size: 40rpx;
  font-weight: 600;
}

.assets__label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--c-text-weak);
}

.assets__split {
  margin-top: 14rpx;
  text-align: center;
  font-size: 21rpx;
  color: var(--c-text-weak);
}

/* ── 权益 ─────────────────────────────────────────────────── */

.benefits {
  display: flex;
  padding: 30rpx 0;
}

.benefits__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.benefits__icon {
  width: 48rpx;
  height: 48rpx;
}

.benefits__label {
  margin-top: 14rpx;
  font-size: 23rpx;
}

.benefits__sub {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--c-text-weak);
  text-align: center;
}

/* ── 活动 ─────────────────────────────────────────────────── */

.promo {
  display: flex;
  align-items: center;
  padding: 24rpx;
}

.promo__title {
  font-family: var(--font-serif);
  font-size: 32rpx;
  font-weight: 600;
}

.promo__sub {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--c-text-sub);
}

.promo__btn {
  width: 200rpx;
  margin-top: 20rpx;
}

.promo__photo {
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--r-md);
  margin-left: 20rpx;
  flex-shrink: 0;
}

/* ── 绑定引导 ─────────────────────────────────────────────── */

.bind {
  margin-top: 40rpx;
  padding: 48rpx 36rpx;
  background: var(--c-card);
  border-radius: var(--r-lg);
  text-align: center;
}

.bind__title {
  font-family: var(--font-serif);
  font-size: 36rpx;
  font-weight: 600;
}

.bind__text {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--c-text-sub);
}

.bind__btn {
  margin-top: 32rpx;
  line-height: 88rpx;
  border: none;
}

.bind__btn::after {
  border: none;
}

.empty__action {
  margin-top: 28rpx;
}
