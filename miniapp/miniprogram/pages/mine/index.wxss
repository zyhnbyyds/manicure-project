/* 个人中心 —— 对齐 docs/design.png 第 5 屏 */

/* ── 自定义导航栏 ─────────────────────────────────────────── */

.navbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding-left: 28rpx;
  box-sizing: content-box;
}

/* 设计稿左上角是一枚圆形头像；这里用昵称做无图兜底，避免空白圆 */
.navbar__avatar {
  max-width: 220rpx;
  height: 72rpx;
  padding: 0 22rpx;
  border-radius: var(--r-pill);
  background: var(--c-chip);
  color: var(--c-text-sub);
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-sizing: border-box;
}

.navbar__settings {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.navbar__settings-icon {
  width: 44rpx;
  height: 44rpx;
}

/* ── 用户区 ───────────────────────────────────────────────── */

.user {
  padding: 8rpx 8rpx 0;
}

.user__name {
  display: flex;
  align-items: center;
  font-family: var(--font-serif);
  font-size: 46rpx;
  font-weight: 600;
}

.user__badge {
  margin-left: 16rpx;
  height: 40rpx;
  line-height: 40rpx;
  padding: 0 18rpx;
  border-radius: var(--r-pill);
  background: var(--c-gradient);
  color: var(--c-primary-deep);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
  font-size: 20rpx;
  font-weight: 400;
}

.user__slogan {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: var(--c-text-sub);
}

.user__bind {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--c-text-weak);
}

/* ── 三列数据 ─────────────────────────────────────────────── */

.stats {
  display: flex;
  margin-top: 36rpx;
}

.stats__item {
  flex: 1;
  text-align: center;
}

.stats__value {
  font-family: var(--font-serif);
  font-size: 44rpx;
  font-weight: 600;
}

.stats__label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--c-text-weak);
}

/* ── 订单入口 ─────────────────────────────────────────────── */

.orders {
  display: flex;
  padding: 28rpx 0;
}

.orders__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.orders__icon {
  width: 46rpx;
  height: 46rpx;
}

.orders__label {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--c-text-sub);
}

/* ── 功能列表 ─────────────────────────────────────────────── */

.menu {
  padding: 4rpx 28rpx;
}

.menu__item {
  display: flex;
  align-items: center;
  height: 104rpx;
  border-bottom: 2rpx solid var(--c-border);
}

.menu__item--last {
  border-bottom: none;
}

.menu__icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 22rpx;
}

.menu__value {
  margin-right: 12rpx;
  font-size: 23rpx;
  color: var(--c-text-weak);
}

.menu__arrow {
  font-size: 34rpx;
  color: var(--c-text-weak);
}

/* ── 工作台块 ─────────────────────────────────────────────── */

.staff-block {
  display: flex;
  align-items: center;
}

.staff-block__text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: var(--c-text-sub);
  line-height: 1.5;
}

.staff-block__btn {
  margin-left: 20rpx;
  flex-shrink: 0;
}

/* ── 底部按钮 ─────────────────────────────────────────────── */

.login-btn {
  margin-top: 40rpx;
}

.logout {
  margin-top: 40rpx;
}

/* 未登录 / 未绑定引导卡（登录态区分） */
.guest {
  margin-top: 36rpx;
  text-align: center;
}

.guest__title {
  font-family: var(--font-serif);
  font-size: 32rpx;
  font-weight: 600;
}

.guest__text {
  margin-top: 12rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: var(--c-text-sub);
}

.guest__btn {
  margin-top: 28rpx;
}