/* 个人中心 —— 对齐新设计稿 manicure-ui-mine-v2 */

/* ── 自定义导航栏（只有左上角一枚太阳） ────────────────────── */

.navbar {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding-left: 28rpx;
  box-sizing: content-box;
}

.navbar__theme {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.navbar__theme-icon {
  width: 44rpx;
  height: 44rpx;
}

/* ── 用户卡（不加卡片底，直接落在页面底色上，靠留白分区） ───── */

.user {
  display: flex;
  align-items: center;
  padding: 8rpx 8rpx 0;
}

.user__avatar-wrap {
  position: relative;
  flex-shrink: 0;
  width: 148rpx;
  height: 148rpx;
  margin-right: 24rpx;
}

.user__avatar {
  width: 148rpx;
  height: 148rpx;
  border-radius: 50%;
  background: var(--c-chip);
}

/* 没头像时用昵称首字兜底（不伪造一张别人的照片） */
.user__avatar--text {
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-serif);
  font-size: 56rpx;
  color: var(--c-primary-deep);
  background: var(--c-primary-soft);
}

/* 右下角相机角标：与「个人资料」页同款（纯 CSS 画，项目不引图标包） */
.user__camera {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 4rpx solid var(--c-bg);
  background: var(--c-primary);
  display: flex;
  align-items: center;
  justify-content: center;
}

.user__camera-lens {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  border: 4rpx solid #fff;
}

.user__body {
  min-width: 0;
}

.user__name {
  display: flex;
  align-items: center;
}

.user__name-text {
  max-width: 300rpx;
  font-family: var(--font-serif);
  font-size: 40rpx;
  font-weight: 600;
}

/* 等级标签：贴纸式小胶囊（与卡面的等级材质无关，这里是列表语境） */
.user__badge {
  flex-shrink: 0;
  margin-left: 14rpx;
  height: 38rpx;
  line-height: 38rpx;
  padding: 0 16rpx;
  border-radius: var(--r-pill);
  background: var(--c-chip);
  color: var(--c-text-sub);
  font-size: 20rpx;
}

.user__slogan {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--c-text-sub);
}

.user__bind {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--c-text-weak);
}

.user__arrow {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 34rpx;
  color: var(--c-text-weak);
}

/* ── 统计卡（上排三列 + 下排积分余额） ─────────────────────── */

.stat {
  margin-top: 30rpx;
  padding: 0;
}

.stat__row {
  display: flex;
  padding: 26rpx 0 22rpx;
}

.stat__item {
  flex: 1;
  text-align: center;
}

.stat__value {
  font-family: var(--font-serif);
  font-size: 44rpx;
  font-weight: 600;
}

.stat__label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--c-text-weak);
}

.stat__split {
  height: 2rpx;
  margin: 0 28rpx;
  background: var(--c-border);
}

.stat__assets {
  display: flex;
  align-items: center;
  padding: 22rpx 28rpx;
}

.stat__asset {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.stat__asset--right {
  justify-content: flex-start;
  padding-left: 24rpx;
}

/* ¥ 与 ◎：用文字/圆环画，避免为两个符号引图标 */
.stat__asset-icon {
  flex-shrink: 0;
  width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  margin-right: 10rpx;
  border-radius: 50%;
  border: 2rpx solid var(--c-border);
  color: var(--c-text-sub);
  font-size: 20rpx;
}

.stat__asset-icon--ring {
  border: 4rpx solid var(--c-border);
  background: transparent;
}

.stat__asset-label {
  flex-shrink: 0;
  margin-right: 10rpx;
  font-size: 23rpx;
  color: var(--c-text-sub);
}

.stat__asset-value {
  font-family: var(--font-serif);
  font-size: 26rpx;
  font-weight: 600;
}

.stat__arrow {
  flex-shrink: 0;
  margin-left: 8rpx;
  font-size: 32rpx;
  color: var(--c-text-weak);
}

/* ── 订单入口 ─────────────────────────────────────────────── */

.orders {
  display: flex;
  padding: 28rpx 0;
}

.orders__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.orders__icon-wrap {
  position: relative;
}

.orders__icon {
  width: 46rpx;
  height: 46rpx;
}

/* 待支付角标：真实数量，为 0 时不渲染 */
.orders__badge {
  position: absolute;
  top: -12rpx;
  right: -18rpx;
  min-width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  padding: 0 8rpx;
  border-radius: var(--r-pill);
  background: var(--c-primary);
  color: #fff;
  font-size: 18rpx;
  text-align: center;
}

.orders__label {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--c-text-sub);
}

/* ── 功能列表 ─────────────────────────────────────────────── */

.menu {
  padding: 4rpx 28rpx;
}

.menu__item {
  display: flex;
  align-items: center;
  height: 104rpx;
  border-bottom: 2rpx solid var(--c-border);
}

.menu__item--last {
  border-bottom: none;
}

.menu__icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 22rpx;
}

.menu__value {
  margin-right: 12rpx;
  font-size: 23rpx;
  color: var(--c-text-weak);
}

.menu__arrow {
  font-size: 34rpx;
  color: var(--c-text-weak);
}

/* ── 工作台块 ─────────────────────────────────────────────── */

.staff-block {
  display: flex;
  align-items: center;
}

.staff-block__text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: var(--c-text-sub);
  line-height: 1.5;
}

.staff-block__btn {
  margin-left: 20rpx;
  flex-shrink: 0;
}

/* ── 底部按钮 ─────────────────────────────────────────────── */

.login-btn {
  margin-top: 40rpx;
}

/* 退出登录：设计稿是**描边胶囊**（不是填充按钮），保持「危险动作低调」 */
.logout {
  margin: 44rpx 0 0;
  border-radius: var(--r-pill);
}

/* 未登录 / 未绑定引导卡（登录态区分） */
.guest {
  margin-top: 30rpx;
  text-align: center;
}

.guest__title {
  font-family: var(--font-serif);
  font-size: 32rpx;
  font-weight: 600;
}

.guest__text {
  margin-top: 12rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: var(--c-text-sub);
}

.guest__btn {
  margin-top: 28rpx;
}
