<view class="page page-with-tabbar" style="{{themeStyle}}">
  <!-- 自定义导航栏（设计稿：左侧头像、右侧设置齿轮，无标题） -->
  <view
    class="navbar"
    style="padding-top:{{statusBarHeight}}px;padding-right:{{navRightGap}}px"
  >
    <view class="navbar__avatar">{{nickname}}</view>
    <view class="navbar__settings" bindtap="onSettings">
      <image class="navbar__settings-icon" src="{{icons.settings}}" mode="aspectFit" />
    </view>
  </view>

  <view class="page-body">
    <!-- 用户区（不加卡片，直接落在底色上，靠留白分区） -->
    <view class="user">
      <view class="user__name">
        {{nickname}}
        <view wx:if="{{levelName}}" class="user__badge">{{levelName}}</view>
      </view>
      <view class="user__slogan">{{slogan}}</view>
      <view class="user__bind">{{bindText}}</view>
    </view>

    <!-- 三列数据：**只有已绑定才显示**。未登录时显示 0 会让人误以为「我的资产是 0」 -->
    <view wx:if="{{bound}}" class="stats">
      <view class="stats__item" data-key="booking" bindtap="onStatTap">
        <view class="stats__value">{{bookingCount}}</view>
        <view class="stats__label">我的预约</view>
      </view>
      <view class="stats__item" data-key="favorite" bindtap="onStatTap">
        <view class="stats__value">{{favoriteCount}}</view>
        <view class="stats__label">收藏款式</view>
      </view>
      <view class="stats__item" data-key="coupon" bindtap="onStatTap">
        <view class="stats__value">{{couponCount}}</view>
        <view class="stats__label">优惠券</view>
      </view>
    </view>

    <!-- 未绑定：登录引导（文案区分「没登录」与「登录了没绑手机号」） -->
    <view wx:else class="card guest">
      <view class="guest__title">
        {{loggedIn ? '绑定手机号，解锁会员权益' : '登录后查看会员权益'}}
      </view>
      <view class="guest__text">储值余额、积分、次卡与优惠券都会在这里显示</view>
      <view class="btn btn--primary btn--block guest__btn" bindtap="onGuestAction">去登录 / 绑定</view>
    </view>

    <!-- 我的订单（同样只有已绑定才有意义） -->
    <view wx:if="{{bound}}" class="section">
      <view class="section__title">我的订单</view>
      <view class="section__more" bindtap="goBookings">查看全部 ›</view>
    </view>
    <view wx:if="{{bound}}" class="card orders">
      <view
        wx:for="{{orderTabs}}"
        wx:key="label"
        class="orders__item"
        data-key="{{item.key}}"
        bindtap="onOrderTab"
      >
        <image class="orders__icon" src="{{icons[item.icon]}}" mode="aspectFit" />
        <view class="orders__label">{{item.label}}</view>
      </view>
    </view>

    <!-- 功能列表 -->
    <view class="card menu">
      <view
        wx:for="{{menu}}"
        wx:key="key"
        class="menu__item"
        data-key="{{item.key}}"
        bindtap="onMenuTap"
      >
        <image class="menu__icon" src="{{icons[item.icon]}}" mode="aspectFit" />
        <view class="grow">{{item.label}}</view>
        <view class="menu__arrow">›</view>
      </view>
      <view class="menu__item menu__item--last" bindtap="goTheme">
        <image class="menu__icon" src="{{icons.settings}}" mode="aspectFit" />
        <view class="grow">主题设置</view>
        <view class="menu__value">{{themeLine}}</view>
        <view class="menu__arrow">›</view>
      </view>
    </view>

    <!-- 美甲师工作台（只有申请过的人才看得到，文案由 store/mode 决定） -->
    <view wx:if="{{staffText}}" class="card staff-block">
      <view class="staff-block__text">{{staffText}}</view>
      <view
        wx:if="{{granted}}"
        class="btn btn--primary btn--sm staff-block__btn"
        bindtap="onEnterWorkbench"
      >
        进入工作台
      </view>
      <view wx:else class="btn btn--soft btn--sm staff-block__btn" bindtap="onApplyStaff">
        {{applying ? '提交中…' : '申请开通'}}
      </view>
    </view>

    <view wx:if="{{!bound}}" class="btn btn--primary btn--block login-btn" bindtap="onLogin">
      {{logging ? '登录中…' : '微信一键登录'}}
    </view>
    <view wx:else class="btn btn--ghost btn--block logout" bindtap="onLogout">退出登录</view>

    <view class="safe-bottom"></view>
  </view>
</view>
