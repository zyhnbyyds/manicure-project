<view class="page" style="{{themeStyle}}">
  <view class="page-body booking-body">
    <!-- 已选款式摘要（设计稿顶部那张卡） -->
    <!-- 未选款式时摘要卡与后续区块都不该出现 -->
    <view wx:if="{{!emptyDraft}}" class="picked">
      <image class="picked__photo" src="{{pickedImage}}" mode="aspectFill" />
      <view class="grow">
        <view class="picked__name ellipsis">{{itemNames}}</view>
        <view class="picked__meta">{{durationText}}</view>
      </view>
      <view class="price picked__price">
        <text class="price__symbol">¥</text>
        <text class="price__yuan">{{totalText}}</text>
      </view>
    </view>

    <view wx:if="{{emptyDraft}}" class="empty anim-pop">
      <view class="empty__text">还没有选款式</view>
      <view class="empty__hint">先挑一款喜欢的款式，才知道要给你留多久～</view>
      <view class="btn btn--primary btn--sm empty__action" bindtap="goPickService">去挑款式</view>
    </view>

    <view wx:elif="{{loading}}" class="loading">正在看哪位美甲师有空…</view>

    <view wx:elif="{{errorText}}" class="empty anim-pop">
      <view class="empty__text">{{errorText}}</view>
      <view class="btn btn--primary btn--sm empty__action" bindtap="onRetry">重新加载</view>
    </view>

    <view wx:else class="anim-rise">
      <!-- 选择时间 -->
      <view class="section">
        <view class="section__title">选择时间</view>
      </view>
      <scroll-view class="dates" scroll-x enable-flex show-scrollbar="{{false}}">
        <view class="dates__row">
          <view
            wx:for="{{dateChips}}"
            wx:key="value"
            class="dates__item {{activeDate === item.value ? 'is-active' : ''}}"
            data-date="{{item.value}}"
            bindtap="onDate"
          >
            <view class="dates__label">{{item.label}}</view>
            <view class="dates__date">{{item.monthDay}}</view>          </view>
        </view>
      </scroll-view>

      <!-- 时段网格：3 列 -->
      <view wx:if="{{timeSlots.length > 0}}" class="slots">
        <view
          wx:for="{{timeSlots}}"
          wx:key="startAt"
          class="slots__item press-sm {{selectedStart === item.startAt ? 'is-active' : ''}}"
          data-start="{{item.startAt}}"
          bindtap="onSlot"
        >
          {{item.timeText}}
        </view>
      </view>
      <view wx:else class="slots-empty">
        <view class="slots-empty__text">{{reasonText}}</view>
        <view class="slots-empty__hint">换个日期或换位美甲师试试</view>
      </view>

      <!-- 选择美甲师 -->
      <view class="section">
        <view class="section__title">选择美甲师</view>
      </view>
      <view class="staffs">
        <view
          wx:for="{{staffList}}"
          wx:key="id"
          class="staffs__item press-sm {{item.disabled ? 'is-disabled' : ''}}"
          data-id="{{item.id}}"
          bindtap="onPickStaff"
        >
          <view class="staffs__ring {{item.selected ? 'is-selected' : ''}}">
            <image class="staffs__avatar" src="{{item.avatarResolved}}" mode="aspectFill" />
          </view>
          <view class="staffs__name ellipsis">{{item.nickname}}</view>
        </view>
      </view>

      <!-- 备注（选填） -->
      <view class="section">
        <view class="section__title">备注（选填）</view>
      </view>
      <textarea
        class="remark"
        value="{{remark}}"
        placeholder="如有特殊要求，请留言…"
        placeholder-class="remark__placeholder"
        maxlength="200"
        bindinput="onRemarkInput"
      />
    </view>
  </view>

  <view class="action-bar">
    <view class="grow">
      <view class="action-bar__label">合计</view>
      <view class="price">
        <text class="price__symbol">¥</text>
        <text class="price__yuan">{{totalText}}</text>
      </view>
    </view>
    <view class="btn btn--primary action-bar__submit" bindtap="goNext">确认预约</view>
  </view>
</view>
