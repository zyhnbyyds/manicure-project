/* 支付结果 —— 严格对齐 docs/manicure-ui-batch2 第 1 屏 */

.result-body {
  padding-top: 60rpx;
  text-align: center;
}

/* ── 状态图标 ─────────────────────────────────────────────── */

.badge {
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: var(--c-primary);
  display: flex;
  align-items: center;
  justify-content: center;
}

.badge--pending {
  background: var(--c-accent);
}

.badge__icon {
  width: 76rpx;
  height: 76rpx;
}

/* ── 文案 ─────────────────────────────────────────────────── */

.title {
  margin-top: 36rpx;
  font-family: var(--font-serif);
  font-size: 44rpx;
  font-weight: 600;
}

.subtitle {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: var(--c-text-sub);
}

.amount {
  margin-top: 16rpx;
  font-family: var(--font-serif);
  font-size: 40rpx;
  font-weight: 600;
  color: var(--c-primary);
}

/* ── 提示卡 ───────────────────────────────────────────────── */

.tip {
  margin-top: 24rpx;
  text-align: left;
}

.tip__label {
  font-size: 26rpx;
  font-weight: 600;
}

.tip__text {
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: var(--c-text-sub);
  white-space: pre-wrap;
}

/* ── 底部动作 ─────────────────────────────────────────────── */

.result__primary {
  margin-top: 48rpx;
}

.result__link {
  margin-top: 28rpx;
  font-size: 26rpx;
  color: var(--c-text-weak);
}
