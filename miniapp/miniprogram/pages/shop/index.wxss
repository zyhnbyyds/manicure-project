/* 门店信息 —— 对齐 docs/manicure-ui-batch1 第 6 屏 */

.shop-body {
  padding-bottom: 200rpx;
}

.hero {
  width: 100%;
  height: 380rpx;
  border-radius: var(--r-lg);
  display: block;
}

/* ── 门店名 ───────────────────────────────────────────────── */

.head {
  margin-top: 28rpx;
}

.head__row {
  display: flex;
  align-items: center;
}

/* 门店名左侧的品牌标记：与 44rpx 的店名同高，行内对齐 */
.head__logo {
  width: 72rpx;
  height: 72rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.head__name {
  font-family: var(--font-serif);
  font-size: 44rpx;
  font-weight: 600;
}

.head__slogan {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--c-text-sub);
}

.head__tag {
  display: inline-block;
  margin-top: 16rpx;
  height: 42rpx;
  line-height: 42rpx;
  padding: 0 20rpx;
  border-radius: var(--r-pill);
  background: var(--c-primary-soft);
  color: var(--c-primary-deep);
  font-size: 21rpx;
}

/* ── 信息行 ───────────────────────────────────────────────── */

.rows {
  margin-top: 28rpx;
  padding: 4rpx 28rpx;
}

.row {
  display: flex;
  align-items: center;
  height: 104rpx;
  border-bottom: 2rpx solid var(--c-border);
}

.row--last {
  border-bottom: none;
}

.row__icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 22rpx;
  flex-shrink: 0;
}

.row__label {
  width: 150rpx;
  font-size: 27rpx;
}

.row__value {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-size: 24rpx;
  color: var(--c-text-sub);
}

/* ── 门店公告（来源：后台参数配置 `biz.shop.notice`） ─────── */

.notice-bar {
  margin-top: 20rpx;
}

.notice-bar__label {
  font-size: 22rpx;
  color: var(--c-primary-deep);
  font-weight: 600;
}

.notice-bar__text {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--c-text-sub);
}

/* ── 选择门店（多店才有；单店期整个区块不渲染） ─────── */

.store-pick {
  margin-top: 20rpx;
}

.store-pick__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.store-pick__title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--c-text);
}

.store-pick__locate {
  font-size: 22rpx;
  color: var(--c-primary-deep);
}

.store-pick__locate.is-busy {
  color: var(--c-text-sub);
}

.store {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
}

/* 相邻项才画分隔线：第一项上方不该有线 */
.store + .store {
  border-top: 1rpx solid var(--c-border);
}

.store__main {
  flex: 1;
  min-width: 0;
}

.store__name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--c-text);
}

.store--active .store__name {
  color: var(--c-primary-deep);
}

.store__tag {
  margin-left: 8rpx;
  padding: 0 6rpx;
  font-size: 20rpx;
  font-weight: 400;
  color: var(--c-text-sub);
  border: 1rpx solid var(--c-border);
  border-radius: 6rpx;
}

.store__addr {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--c-text-sub);
}

.store__right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
}

.store__distance {
  font-size: 22rpx;
  color: var(--c-text-sub);
}

.store__current {
  padding: 2rpx 8rpx;
  font-size: 20rpx;
  color: #fff;
  background: var(--c-primary);
  border-radius: 6rpx;
}
