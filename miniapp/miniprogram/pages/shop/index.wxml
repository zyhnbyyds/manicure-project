<view class="page" style="{{themeStyle}}">
  <view class="page-body shop-body anim-rise">
    <!-- 门店照片 -->
    <image class="hero" src="{{shopImage}}" mode="aspectFill" />

    <!-- 门店名与一句话（左侧一枚品牌 LOGO，让「这是哪家店」一眼有据） -->
    <view class="head">
      <view class="head__row">
        <image class="head__logo" src="{{shop.logo}}" mode="aspectFit" />
        <view class="head__name">{{shop.name}}</view>
      </view>
      <view class="head__slogan">{{shop.slogan}}</view>
      <view class="head__tag">营业中 · {{shop.hours}}</view>
    </view>

    <!-- 门店公告（后台「参数配置」里填；没填就不显示这一块） -->
    <view wx:if="{{notice}}" class="card notice-bar">
      <view class="notice-bar__label">门店公告</view>
      <view class="notice-bar__text">{{notice}}</view>
    </view>

    <!-- 信息行：导航 / 拨号 / 复制微信号都是真实动作 -->
    <view class="card rows">
      <view
        wx:for="{{rows}}"
        wx:key="key"
        class="row press {{index === rows.length - 1 ? 'row--last' : ''}}"
        data-key="{{item.key}}"
        bindtap="onRowTap"
      >
        <image class="row__icon" src="{{icons[item.icon]}}" mode="aspectFit" />
        <view class="row__label">{{item.label}}</view>
        <view class="row__value ellipsis">{{item.value}}</view>
      </view>
    </view>

    <!-- 选择门店：只有一家店时不渲染（单店期不该看到「选门店」这个概念） -->
    <view wx:if="{{stores.length > 1}}" class="card store-pick">
      <view class="store-pick__head">
        <view class="store-pick__title">选择门店</view>
        <view
          class="store-pick__locate press {{locating ? 'is-busy' : ''}}"
          bindtap="onLocate"
        >
          {{locating ? '定位中…' : (located ? '已按距离排序' : '📍 找最近的门店')}}
        </view>
      </view>

      <view
        wx:for="{{stores}}"
        wx:key="id"
        class="store press {{item.id === currentStoreId ? 'store--active' : ''}}"
        data-id="{{item.id}}"
        bindtap="onPickStore"
      >
        <view class="store__main">
          <view class="store__name">
            {{item.name}}
            <text wx:if="{{item.isDefault}}" class="store__tag">默认</text>
          </view>
          <view class="store__addr ellipsis">{{item.address || '未填写地址'}}</view>
        </view>
        <view class="store__right">
          <view wx:if="{{item.distanceText}}" class="store__distance">{{item.distanceText}}</view>
          <view wx:if="{{item.id === currentStoreId}}" class="store__current">当前</view>
        </view>
      </view>
    </view>

    <view class="tips">到店前可以先跟客服约时间，我们会帮你留位。</view>
  </view>

  <view class="action-bar">
    <view class="btn btn--primary btn--block press" bindtap="goBooking">预约到店</view>
  </view>
</view>
