.fav-body {
  padding-bottom: 60rpx;
}

.head {
  font-family: var(--font-serif);
  font-size: 30rpx;
  font-weight: 600;
}

.cats {
  width: 100%;
  white-space: nowrap;
  margin-top: 22rpx;
}

.cats__row {
