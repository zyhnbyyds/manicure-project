/* 我的优惠券 —— 对齐 docs/manicure-ui-batch4 第 5 屏 */

/*
 * 页签条现在在 `.page-body` 之外（要吸顶，见 app.wxss `.sticky-head`），
 * 所以左右/上内边距得自己带一份（数值与原 `.page-body` 的 24rpx 对齐）；
 * `.coupon-body` 的 `padding-top` 归零，保持「页签 → 第一张券」的间距与改动前一致。
 */
.tabs-head {
  padding: 24rpx 24rpx 0;
}

.coupon-body {
  padding-top: 0;
  padding-bottom: 60rpx;
}

/* ── 状态页签 ─────────────────────────────────────────────── */

.tabs {
  display: flex;
  padding: 6rpx;
  background: var(--c-chip);
  border-radius: var(--r-pill);
}

.tabs__item {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: var(--r-pill);
  font-size: 25rpx;
  color: var(--c-text-sub);
}

.tabs__item.is-active {
  background: var(--c-card);
  color: var(--c-text);
  font-weight: 600;
}

/* ── 券卡：左面额 + 竖虚线 + 右信息 ───────────────────────── */

.coupon {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding: 24rpx 20rpx;
}

/* 不可用的券整体降饱和，但仍看得清内容 */
.coupon--muted {
  opacity: 0.62;
}

.coupon__amount {
  width: 190rpx;
  flex-shrink: 0;
  text-align: center;
}

.coupon__value {
  font-family: var(--font-serif);
  font-size: 48rpx;
  font-weight: 600;
  line-height: 1.1;
  color: var(--c-primary);
}

.coupon__symbol {
  font-size: 26rpx;
  margin-right: 2rpx;
}

.coupon__threshold {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--c-text-weak);
}

/* 竖虚线分隔（票券的典型视觉） */
.coupon__split {
  width: 2rpx;
  height: 110rpx;
  margin: 0 20rpx;
  flex-shrink: 0;
  border-left: 2rpx dashed var(--c-border);
}

.coupon__info {
  flex: 1;
  min-width: 0;
}

.coupon__status {
  display: inline-block;
  height: 40rpx;
  line-height: 40rpx;
  padding: 0 16rpx;
  border-radius: var(--r-pill);
  font-size: 20rpx;
  background: var(--c-primary-soft);
  color: var(--c-primary-deep);
}

.coupon__status--used {
  background: var(--c-chip);
  color: var(--c-text-sub);
}

.coupon__status--expired,
.coupon__status--void {
  background: var(--c-bg);
  color: var(--c-text-weak);
}

.coupon__expire {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--c-text-sub);
}

.coupon__no {
  margin-top: 4rpx;
  font-size: 19rpx;
  color: var(--c-text-weak);
}

.coupon__use {
  flex-shrink: 0;
  margin-left: 16rpx;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 24rpx;
  border-radius: var(--r-pill);
  background: var(--c-primary);
  color: var(--c-on-primary);
  font-size: 23rpx;
}

/* 券名：卡片标题（模板名，后端已给到顾客侧） */
.coupon__name {
  margin-bottom: 8rpx;
  font-family: var(--font-serif);
  font-size: 28rpx;
  font-weight: 600;
}
