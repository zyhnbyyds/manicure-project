/* 消息中心 —— 对齐 docs/manicure-ui-batch5 第 2 屏（缺读取接口，先还原骨架） */

/*
 * 页签条在 `.page-body` 之外（要吸顶，见 app.wxss `.sticky-head`）：
 * 左右/上内边距自己带一份（与原 `.page-body` 的 24rpx 对齐），
 * `.notice-body` 的 `padding-top` 归零，保持与改动前同样的间距。
 */
.bar-head {
  padding: 24rpx 24rpx 0;
}

.notice-body {
  padding-top: 0;
  padding-bottom: 60rpx;
}

/* ── 页签条 ───────────────────────────────────────────────── */

.bar {
  display: flex;
  align-items: center;
}

.bar__scroll {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}

.bar__row {
  display: flex;
}

.bar__read {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 23rpx;
  color: var(--c-text-sub);
}

/* ── 消息卡（有数据时用；当前为空态）──────────────────────── */

.notice {
  display: flex;
  align-items: flex-start;
  margin-top: 20rpx;
}

.notice__icon-wrap {
  /* 未读小圆点相对它定位 */
  position: relative;
  width: 72rpx;
  height: 72rpx;
  margin-right: 20rpx;
  border-radius: 50%;
  background: var(--c-chip);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.notice__icon {
  width: 36rpx;
  height: 36rpx;
}

.notice__title {
  font-size: 27rpx;
  font-weight: 600;
}

/* 标题与时间同一行：时间靠右，长标题省略号截断 */
.notice__top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.notice__time {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 20rpx;
  color: var(--c-text-weak);
}

.notice__text {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: var(--c-text-sub);
}

/* 分类标签：让顾客知道这条为什么在这里（也方便对上页签） */
.notice__cat {
  display: inline-block;
  margin-top: 10rpx;
  padding: 0 12rpx;
  height: 32rpx;
  line-height: 32rpx;
  border-radius: var(--r-pill);
  background: var(--c-chip);
  color: var(--c-text-sub);
  font-size: 18rpx;
}

/* 未读：卡片左侧一条主色竖线（扫一眼就知道哪些没看） */
.notice.is-unread {
  position: relative;
}

.notice.is-unread::before {
  content: '';
  position: absolute;
  top: 24rpx;
  bottom: 24rpx;
  left: 0;
  width: 6rpx;
  border-radius: 0 6rpx 6rpx 0;
  background: var(--c-primary);
}

/* 图标右上角的未读小圆点 */
.notice__dot {
  position: absolute;
  top: 0;
  right: 0;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--c-primary);
}

/* 「全部已读」上的未读计数 */
.bar__unread {
  margin-left: 6rpx;
  padding: 0 8rpx;
  border-radius: var(--r-pill);
  background: var(--c-primary);
  color: #fff;
  font-size: 18rpx;
}

.end {
  margin-top: 30rpx;
  text-align: center;
  font-size: 21rpx;
  color: var(--c-text-weak);
}

/* ── 空态 ─────────────────────────────────────────────────── */

.empty__badge {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 28rpx;
  border-radius: 50%;
  background: var(--c-chip);
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty__icon {
  width: 68rpx;
  height: 68rpx;
  opacity: 0.5;
}
