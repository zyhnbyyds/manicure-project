<view class="page detail" style="{{themeStyle}}">
  <view wx:if="{{loading}}" class="loading">加载中…</view>

  <view wx:elif="{{!item}}" class="empty anim-pop">
    <view class="empty__text">{{errorText}}</view>
    <view class="btn btn--primary btn--sm empty__action" bindtap="onRetry">重新加载</view>
  </view>

  <block wx:else>
    <!-- 沉浸式大图：返回/分享浮在图上，右下角图片计数角标 -->
    <view class="hero anim-rise">
      <image class="hero__img" src="{{item.imageResolved}}" mode="aspectFill" />
      <view
        class="hero__nav"
        style="padding-top:{{statusBarHeight}}px;padding-right:{{navRightGap}}px"
      >
        <view class="hero__btn press-sm" bindtap="onBack">
          <image class="hero__icon" src="{{iconsWhite.back}}" mode="aspectFit" />
        </view>
        <view class="hero__btn press-sm" bindtap="onShare">
          <image class="hero__icon" src="{{iconsWhite.share}}" mode="aspectFit" />
        </view>
      </view>
      <view class="hero__count">{{photoCountText}}</view>
    </view>

    <view class="body anim-rise">
      <!-- 标题与价格同一行，设计稿里两者字号相当 -->
      <view class="head">
        <view class="head__name grow">{{item.name}}</view>
        <view class="price">
          <text class="price__symbol">¥</text>
          <text class="price__yuan">{{item.priceYuan}}</text>
        </view>
      </view>
      <view class="head__meta">{{item.durationText}} · {{item.category}}</view>

      <view class="desc">{{item.description}}</view>

      <!-- 适合人群（无对应字段：静态展示） -->
      <view class="section">
        <view class="section__title">适合人群</view>
      </view>
      <view class="tags">
        <view wx:for="{{suitableFor}}" wx:key="*this" class="tag-chip">{{item}}</view>
      </view>

      <!-- 颜色选择（无对应字段：本地视觉态） -->
      <view class="section">
        <view class="section__title">颜色选择</view>
        <view class="section__more press-sm" bindtap="onMoreColors">
          更多
          <image class="section__arrow" src="{{icons.chevron}}" mode="aspectFit" />
        </view>
      </view>
      <view class="swatches">
        <view
          wx:for="{{swatches}}"
          wx:key="hex"
          class="swatch press-sm {{activeSwatch === index ? 'is-active' : ''}}"
          style="background: {{item.hex}}"
          data-index="{{index}}"
          bindtap="onPickSwatch"
        ></view>
      </view>

      <!-- 推荐美甲师 -->
      <view wx:if="{{staff}}" class="staff-card press" bindtap="onStaffTap">
        <image class="staff-card__avatar" src="{{staff.avatarResolved}}" mode="aspectFill" />
        <view class="grow">
          <view class="staff-card__label">推荐美甲师</view>
          <view class="staff-card__name">
            {{staff.nickname}}
            <text class="staff-card__bio">{{staff.bio}}</text>
          </view>
        </view>
        <image class="staff-card__arrow" src="{{icons.chevron}}" mode="aspectFit" />
      </view>
    </view>

    <!-- 底部操作条：收藏 / 客服 / 立即预约 -->
    <view class="action-bar detail-bar">
      <view class="detail-bar__icon-btn press-sm" bindtap="onFavorite">
        <image class="detail-bar__icon" src="{{icons.heart}}" mode="aspectFit" />
        <view class="detail-bar__label">收藏</view>
      </view>
      <view class="detail-bar__icon-btn press-sm" bindtap="onService">
        <image class="detail-bar__icon" src="{{icons.headset}}" mode="aspectFit" />
        <view class="detail-bar__label">客服</view>
      </view>
      <view class="btn btn--primary detail-bar__submit" bindtap="goBook">立即预约</view>
    </view>
  </block>
</view>
