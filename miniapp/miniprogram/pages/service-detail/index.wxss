/* 项目详情 */

.hero {
  position: relative;
  overflow: hidden;
  border-radius: var(--r-xl);
  padding: 32rpx;
  background: var(--c-gradient);
  box-shadow: 0 12rpx 32rpx var(--c-shadow);
  text-align: center;
}

.hero__tile {
  width: 100%;
  height: 380rpx;
  background: rgba(255, 255, 255, 0.6);
}

.hero__img {
  width: 100%;
  height: 100%;
  border-radius: var(--r-md);
  font-size: 140rpx;
}

.hero__name {
  position: relative;
  z-index: 1;
  margin-top: 26rpx;
  font-size: 40rpx;
  font-weight: 800;
}

.hero__tags {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: center;
  margin-top: 18rpx;
}

.hero__tags .tag {
  margin: 0 8rpx;
}

.bubble--a {
  width: 160rpx;
  height: 160rpx;
  top: -50rpx;
  right: -30rpx;
}

.desc {
  margin-top: 16rpx;
  color: var(--c-text-sub);
  font-size: 27rpx;
  line-height: 1.7;
}

.tip-row {
  display: flex;
  align-items: flex-start;
}

.tip-row__emoji {
  font-size: 40rpx;
  line-height: 1.2;
  margin-right: 16rpx;
}

.tip-row__title {
  font-size: 28rpx;
  font-weight: 600;
}

.tip-row__text {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--c-text-sub);
  line-height: 1.6;
}

.action-bar__label {
  font-size: 22rpx;
  color: var(--c-text-sub);
}
