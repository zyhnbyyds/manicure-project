/* 款式详情 —— 严格对齐 docs/design.png 第 3 屏 */

.page.detail {
  padding-bottom: 200rpx;
}

/* ── 沉浸式大图 ───────────────────────────────────────────── */

.hero {
  position: relative;
  width: 100%;
  height: 620rpx;
}

.hero__img {
  width: 100%;
  height: 100%;
  display: block;
}

.hero__nav {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: 28rpx;
  box-sizing: content-box;
}

/* 图上的按钮用半透明底，保证任何照片上都看得见 */
.hero__btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(45, 34, 30, 0.28);
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero__icon {
  width: 36rpx;
  height: 36rpx;
}

/* 右下角「1/1」计数角标 */
.hero__count {
  position: absolute;
  right: 28rpx;
  bottom: 28rpx;
  padding: 6rpx 18rpx;
  border-radius: var(--r-pill);
  background: rgba(45, 34, 30, 0.4);
  color: #ffffff;
  font-size: 22rpx;
}

/* ── 正文 ─────────────────────────────────────────────────── */

.body {
  padding: 32rpx 28rpx 0;
}

.head {
  display: flex;
  align-items: baseline;
}

.head__name {
  font-family: var(--font-serif);
  font-size: 44rpx;
  font-weight: 600;
}

.head__meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--c-text-weak);
}

.desc {
  margin-top: 26rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--c-text-sub);
}

/* ── 适合人群 / 颜色选择 ──────────────────────────────────── */

.section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 40rpx 0 0;
}

.section__more {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: var(--c-text-weak);
}

.section__arrow {
  width: 24rpx;
  height: 24rpx;
  margin-left: 4rpx;
}

.tags {
  display: flex;
  margin-top: 20rpx;
}

.tag-chip {
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 34rpx;
  margin-right: 18rpx;
  border-radius: var(--r-pill);
  background: var(--c-chip);
  color: var(--c-text);
  font-size: 26rpx;
}

.swatches {
  display: flex;
  margin-top: 22rpx;
}

.swatch {
  width: 66rpx;
  height: 66rpx;
  border-radius: 50%;
  margin-right: 22rpx;
  border: 3rpx solid transparent;
  box-sizing: border-box;
}

/* 选中：外圈主色描边 + 内圈留白（设计稿的色号选中态） */
.swatch.is-active {
  border-color: var(--c-primary);
  box-shadow: inset 0 0 0 6rpx var(--c-bg);
}

/* ── 推荐美甲师 ───────────────────────────────────────────── */

.staff-card {
  display: flex;
  align-items: center;
  margin-top: 40rpx;
  padding: 24rpx;
  background: var(--c-card);
  border-radius: var(--r-lg);
}

.staff-card__avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.staff-card__label {
  font-size: 20rpx;
  color: var(--c-text-weak);
}

.staff-card__name {
  margin-top: 6rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.staff-card__bio {
  margin-left: 14rpx;
  font-size: 22rpx;
  color: var(--c-text-weak);
  font-weight: 400;
}

.staff-card__arrow {
  width: 26rpx;
  height: 26rpx;
}

/* ── 底部操作条 ───────────────────────────────────────────── */

.detail-bar {
  align-items: center;
}

.detail-bar__icon-btn {
  width: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 12rpx;
}

.detail-bar__icon {
  width: 40rpx;
  height: 40rpx;
}

.detail-bar__label {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--c-text-sub);
}

/* 已收藏：文案跟着心形一起变主色，否则「实心图标 + 灰字」看着像没生效 */
.detail-bar__label.is-on {
  color: var(--c-primary-deep);
}

.detail-bar__submit {
  flex: 1;
  margin-left: 12rpx;
}
