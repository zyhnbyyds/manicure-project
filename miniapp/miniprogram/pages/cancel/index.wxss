/* 取消说明 —— 对齐 docs/manicure-ui-batch3 第 5 屏 */

.cancel-body {
  padding-bottom: 200rpx;
}

/* ── 订单摘要 ─────────────────────────────────────────────── */

.target__name {
  font-family: var(--font-serif);
  font-size: 32rpx;
  font-weight: 600;
}

.target__when {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: var(--c-text-sub);
}

.target__fee {
  padding-top: 4rpx;
}

.target__value {
  font-family: var(--font-serif);
  font-size: 27rpx;
  color: var(--c-text-sub);
}

.target__value--due {
  color: var(--c-primary);
  font-weight: 600;
}

/* ── 规则 ─────────────────────────────────────────────────── */

.rule {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--c-border);
}

.rule:last-child {
  border-bottom: none;
}

.rule__icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.rule__title {
  font-size: 27rpx;
  font-weight: 600;
}

.rule__text {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: var(--c-text-sub);
}

/* ── 底部 ─────────────────────────────────────────────────── */

.cancel-again {
  width: 240rpx;
  flex-shrink: 0;
}

.confirm-btn {
  flex: 1;
  margin-left: 20rpx;
}


/* ── 费用预览（服务端按门店政策算的真实金额） ─────────────── */

.refund {
  margin-bottom: 20rpx;
}

.refund__title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--c-primary-deep);
}

.refund__row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 16rpx;
}

.refund__value {
  font-family: var(--font-serif);
  font-size: 30rpx;
  font-weight: 600;
}

/* 可退 = 好消息（主色）；扣除 = 需要留意（弱化但不刺眼） */
.refund__value--good {
  color: var(--c-primary-deep);
}

.refund__value--warn {
  color: var(--c-text-sub);
}

.refund__hint {
  margin-top: 16rpx;
  font-size: 21rpx;
  line-height: 1.6;
  color: var(--c-text-weak);
}