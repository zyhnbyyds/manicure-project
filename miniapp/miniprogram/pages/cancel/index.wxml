<view class="page" style="{{themeStyle}}">
  <view wx:if="{{loading}}" class="loading">正在读取订单…</view>

  <view wx:elif="{{errorText}}" class="empty anim-pop">
    <view class="empty__text">{{errorText}}</view>
    <view class="btn btn--primary btn--sm empty__action" bindtap="onThinkAgain">返回</view>
  </view>

  <block wx:else>
    <view class="page-body cancel-body anim-rise">
      <!-- 被取消的订单摘要 -->
      <view class="card target">
        <view class="target__name ellipsis">{{itemNames}}</view>
        <view class="target__when">{{whenText}}</view>
        <view class="divider"></view>
        <view class="target__fee">
          <view class="row-between">
            <view class="text-sub">已支付</view>
            <view class="target__value">{{paidText}} 元</view>
          </view>
          <view class="row-between">
            <view class="text-sub">待支付</view>
            <view class="target__value target__value--due">{{dueText}} 元</view>
          </view>
        </view>
      </view>

      <!-- 取消规则：命中门店政策时显示**真实金额**，没有政策时退回原则性表述 -->
      <view class="section">
        <view class="section__title">取消说明</view>
      </view>

      <view wx:if="{{previewOk}}" class="card refund">
        <view class="refund__title">{{preview.policyName || '按门店规则结算'}}</view>
        <view class="refund__row">
          <view class="text-sub">已付金额</view>
          <view class="refund__value">{{preview.paidText}} 元</view>
        </view>
        <view class="refund__row">
          <view class="text-sub">预计可退</view>
          <view class="refund__value refund__value--good">{{preview.suggestText}} 元</view>
        </view>
        <view wx:if="{{preview.deductAmount > 0}}" class="refund__row">
          <view class="text-sub">按规则扣除</view>
          <view class="refund__value refund__value--warn">{{preview.deductText}} 元</view>
        </view>
        <view class="refund__hint">
          金额由门店退款规则算出；提交后仍需门店审批，实际到账以审批结果为准。
        </view>
      </view>

      <view class="card">
        <view wx:for="{{rules}}" wx:key="title" class="rule">
          <image class="rule__icon" src="{{icons[item.icon]}}" mode="aspectFit" />
          <view class="grow">
            <view class="rule__title">{{item.title}}</view>
            <view class="rule__text">{{item.text}}</view>
          </view>
        </view>
      </view>

      <view class="tips">
        提交取消后，实际可退金额会在「我的预约」中体现；若有异议可直接联系门店协商。
      </view>
    </view>

    <view class="action-bar">
      <view class="btn btn--ghost cancel-again" bindtap="onThinkAgain">我再想想</view>
      <view
        class="btn {{submitting ? 'btn--disabled' : 'btn--primary'}} confirm-btn"
        bindtap="onConfirm"
      >
        {{submitting ? '取消中…' : '确认取消'}}
      </view>
    </view>
  </block>
</view>
