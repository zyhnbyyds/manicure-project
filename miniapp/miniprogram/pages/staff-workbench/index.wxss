/* 美甲师工作台 —— 对齐 docs/manicure-ui-batch2 第 3 屏 */

.wb-body {
  padding-bottom: 40rpx;
}

/* ── 身份卡（设计稿的渐变卡：这里承载身份与今日班次）───────── */

.idcard {
  position: relative;
  overflow: hidden;
  padding: 36rpx 32rpx 30rpx;
  border-radius: var(--r-lg);
  background: var(--c-gradient);
}

.idcard__circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.45);
}

.idcard__circle--a {
  width: 240rpx;
  height: 240rpx;
  top: -90rpx;
  right: -60rpx;
}

.idcard__circle--b {
  width: 110rpx;
  height: 110rpx;
  bottom: -40rpx;
  left: -30rpx;
}

.idcard__mark {
  position: absolute;
  right: 40rpx;
  top: 36rpx;
  font-family: var(--font-serif);
  font-size: 120rpx;
  line-height: 1;
  color: rgba(255, 255, 255, 0.5);
}

.idcard__brand {
  position: relative;
  font-size: 21rpx;
  letter-spacing: 3rpx;
  color: var(--c-text-sub);
}

.idcard__name {
  position: relative;
  margin-top: 12rpx;
  font-family: var(--font-serif);
  font-size: 48rpx;
  font-weight: 600;
}

.idcard__bio {
  position: relative;
  margin-top: 8rpx;
  max-width: 400rpx;
  font-size: 22rpx;
  color: var(--c-text-sub);
}

.idcard__foot {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 44rpx;
}

.idcard__shift {
  font-size: 24rpx;
  color: var(--c-text);
}

.idcard__date {
  font-size: 21rpx;
  letter-spacing: 2rpx;
  color: var(--c-text-sub);
}

/* ── 业绩三列 ─────────────────────────────────────────────── */

.stats {
  display: flex;
  padding: 30rpx 0;
}

.stats__item {
  flex: 1;
  text-align: center;
}

.stats__value {
  font-family: var(--font-serif);
  font-size: 40rpx;
  font-weight: 600;
}

.stats__label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--c-text-weak);
}

.stats__note {
  margin-top: 14rpx;
  text-align: center;
  font-size: 21rpx;
  color: var(--c-text-weak);
}

/* ── 功能入口 ─────────────────────────────────────────────── */

.entries {
  display: flex;
  padding: 28rpx 0;
}

.entries__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.entries__icon {
  width: 46rpx;
  height: 46rpx;
}

.entries__label {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--c-text-sub);
}

/* ── 待服务订单 ───────────────────────────────────────────── */

.order {
  margin-bottom: 20rpx;
}

.order__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order__time {
  font-family: var(--font-serif);
  font-size: 32rpx;
  font-weight: 600;
}

.order__status {
  height: 40rpx;
  line-height: 40rpx;
  padding: 0 18rpx;
  border-radius: var(--r-pill);
  background: var(--c-primary-soft);
  color: var(--c-primary-deep);
  font-size: 20rpx;
}

.pill--waiting {
  background: var(--c-chip);
  color: var(--c-text-sub);
}

.pill--done {
  background: var(--c-bg);
  color: var(--c-text-sub);
}

.pill--cancelled {
  background: var(--c-bg);
  color: var(--c-text-weak);
}

.order__customer {
  margin-top: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.order__phone {
  margin-left: 12rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: var(--c-text-weak);
}

.order__items {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--c-text-sub);
}

.order__meta {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--c-text-weak);
}

.order__due {
  color: var(--c-primary);
}

.order__remark {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--c-text-sub);
}

.order__actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 18rpx;
}

.empty--inline {
  padding: 60rpx 40rpx;
  background: var(--c-card);
  border-radius: var(--r-lg);
}
