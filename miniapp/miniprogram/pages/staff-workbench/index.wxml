<view class="page page-with-tabbar" style="{{themeStyle}}">
  <view class="page-body wb-body">
    <!-- 身份与今日班次：设计稿里那张渐变卡 -->
    <view class="idcard">
      <view class="idcard__circle idcard__circle--a"></view>
      <view class="idcard__circle idcard__circle--b"></view>
      <view class="idcard__mark">S</view>
      <view class="idcard__brand">美甲师工作台</view>
      <view class="idcard__name">{{nickname}}</view>
      <view class="idcard__bio ellipsis">{{bio}}</view>
      <view class="idcard__foot">
        <view class="idcard__shift">{{shiftText}}</view>
        <view class="idcard__date">{{today}}</view>
      </view>
    </view>

    <view wx:if="{{loading}}" class="loading">正在读取今日安排…</view>

    <view wx:elif="{{errorText}}" class="empty">
      <view class="empty__text">{{errorText}}</view>
    </view>

    <block wx:else>
      <!-- 今日业绩 -->
      <view class="section">
        <view class="section__title">今日业绩</view>
        <view class="section__more" bindtap="goStaffPerformance">{{periodText}}</view>
      </view>
      <view class="card stats">
        <view class="stats__item" bindtap="goStaffPerformance">
          <view class="stats__value">{{paidText}}</view>
          <view class="stats__label">服务收入</view>
        </view>
        <view class="stats__item" bindtap="goStaffPerformance">
          <view class="stats__value">{{completedCount}}</view>
          <view class="stats__label">完成单量</view>
        </view>
        <view class="stats__item" bindtap="goStaffPerformance">
          <view class="stats__value">{{accruedText}}</view>
          <view class="stats__label">已计提成</view>
        </view>
      </view>
      <view class="stats__note">已结算 {{settledText}} 元 · 评分 {{ratingText}}</view>

      <!-- 功能入口 -->
      <view class="card entries">
        <view
          wx:for="{{entries}}"
          wx:key="key"
          class="entries__item"
          data-key="{{item.key}}"
          bindtap="onEntryTap"
        >
          <image class="entries__icon" src="{{icons[item.icon]}}" mode="aspectFit" />
          <view class="entries__label">{{item.label}}</view>
        </view>
      </view>

      <!-- 今日待服务 -->
      <view class="section">
        <view class="section__title">今日待服务</view>
        <view class="section__more" bindtap="goStaffBookings">全部 ›</view>
      </view>

      <view wx:if="{{bookings.length === 0}}" class="empty empty--inline">
        <view class="empty__text">{{off ? '今天休息，好好放松一下' : '今天还没有预约'}}</view>
        <view class="empty__hint">有新的预约会出现在这里</view>
      </view>

      <view wx:for="{{bookings}}" wx:key="id" class="card order">
        <view class="order__head">
          <view class="order__time">{{item.timeText}}</view>
          <view class="order__status pill--{{item.tone}}">{{item.statusText}}</view>
        </view>
        <view class="order__customer">
          {{item.customerName}}
          <text class="order__phone">{{item.customerPhoneMasked || '未留电话'}}</text>
        </view>
        <view class="order__items ellipsis-2">{{item.itemNames}}</view>
        <view class="order__meta">
          共 {{item.durationText}} · 应付 {{item.payableText}} 元
          <text wx:if="{{item.dueText !== '0.00'}}" class="order__due">（待付 {{item.dueText}}）</text>
        </view>
        <view wx:if="{{item.remark}}" class="order__remark">备注：{{item.remark}}</view>

        <view class="order__actions">
          <view
            wx:if="{{item.customerPhoneMasked}}"
            class="mini-btn mini-btn--ghost"
            data-id="{{item.id}}"
            bindtap="onCall"
          >
            拨号
          </view>
          <view
            wx:if="{{item.canArrive}}"
            class="mini-btn mini-btn--ghost"
            data-id="{{item.id}}"
            bindtap="onArrive"
          >
            已到店
          </view>
          <view
            wx:if="{{item.canComplete}}"
            class="mini-btn"
            data-id="{{item.id}}"
            bindtap="onComplete"
          >
            完成服务
          </view>
        </view>
      </view>
    </block>
  </view>
</view>
