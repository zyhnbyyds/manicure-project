/* 确认预约 —— 严格对齐 docs/manicure-ui-batch5 第 3 屏（确认预约） */

.confirm-body {
  padding-bottom: 200rpx;
}

/* ── 预约摘要 ─────────────────────────────────────────────── */

.summary__row {
  display: flex;
  align-items: center;
}

.summary__avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.summary__avatar--emoji {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--c-chip);
  font-size: 44rpx;
}

.summary__staff {
  font-family: var(--font-serif);
  font-size: 32rpx;
  font-weight: 600;
}

.summary__time {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--c-text-sub);
}

.summary__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--c-border);
}

.summary__duration {
  font-size: 26rpx;
  color: var(--c-primary);
}

/* ── 项目明细 ─────────────────────────────────────────────── */

.item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
}

.item__name {
  font-size: 28rpx;
  font-weight: 600;
}

.item__price {
  font-family: var(--font-serif);
  font-size: 28rpx;
  color: var(--c-text-sub);
}

/* ── 抵扣三行 ─────────────────────────────────────────────── */

.deduct {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--c-border);
}

.deduct--last {
  border-bottom: none;
  padding-bottom: 0;
}

.deduct__title {
  font-size: 28rpx;
  font-weight: 600;
}

.deduct__sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--c-text-weak);
}

.deduct__pick {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: var(--c-text-sub);
}

.deduct__arrow {
  margin-left: 6rpx;
  font-size: 30rpx;
}

/* ── 优惠明细 ─────────────────────────────────────────────── */

.fee {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 0;
}

.fee__value {
  font-size: 26rpx;
  color: var(--c-text-sub);
}

.fee__value--strong {
  color: var(--c-primary);
  font-weight: 600;
}

.payable__label {
  font-size: 28rpx;
  font-weight: 600;
}

.price-note {
  margin-top: 16rpx;
  font-size: 21rpx;
  line-height: 1.6;
  color: var(--c-text-weak);
}

/* ── 备注 / 绑定提示 ─────────────────────────────────────── */

.remark {
  width: 100%;
  min-height: 140rpx;
  margin-top: 16rpx;
  padding: 24rpx;
  box-sizing: border-box;
  border-radius: var(--r-md);
  background: var(--c-bg);
  font-size: 26rpx;
  color: var(--c-text);
}

.remark__placeholder {
  color: var(--c-text-weak);
}

.bind-tip__title {
  font-size: 28rpx;
  font-weight: 600;
}

.bind-tip__text {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--c-text-sub);
  line-height: 1.6;
}

/* ── 底部 ─────────────────────────────────────────────────── */

.submit {
  width: 300rpx;
  flex-shrink: 0;
}

.empty__action {
  margin-top: 28rpx;
}

/* 券未达门槛的说明：让「少了几张券」有解释，而不是凭空消失 */
.deduct__hint {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--c-text-weak);
}