<view class="page" style="{{themeStyle}}">
  <view wx:if="{{!ready}}" class="empty">
    <view class="empty__text">预约信息不完整</view>
    <view class="empty__hint">请重新选择款式与时间</view>
    <view class="btn btn--primary btn--sm empty__action" bindtap="goPickService">返回上一步</view>
  </view>

  <block wx:else>
    <view class="page-body confirm-body">
      <!-- 预约摘要：美甲师 + 日期时间 + 预计时长 -->
      <view class="card summary">
        <view class="summary__row">
          <image
            wx:if="{{staffAvatar}}"
            class="summary__avatar"
            src="{{staffAvatar}}"
            mode="aspectFill"
          />
          <view wx:else class="summary__avatar summary__avatar--emoji">{{staffEmoji}}</view>
          <view class="grow">
            <view class="summary__staff">{{staffName}}</view>
            <view class="summary__time">{{dateText}} {{timeText}}</view>
          </view>
        </view>
        <view class="summary__foot">
          <view class="text-weak">预计时长</view>
          <view class="summary__duration">{{durationText}}</view>
        </view>
      </view>

      <!-- 项目明细 -->
      <view class="card">
        <view class="section__title">项目明细</view>
        <view wx:for="{{items}}" wx:key="id" class="item">
          <view class="grow">
            <view class="item__name ellipsis">{{item.name}}</view>
            <view class="text-weak">{{item.durationText}}</view>
          </view>
          <view class="item__price">{{item.priceText}}元</view>
        </view>
        <view class="divider"></view>
        <view class="row-between">
          <view class="text-sub">原价总额</view>
          <view class="item__price">{{originalText}}元</view>
        </view>
      </view>

      <!-- 抵扣：积分 / 次卡 / 优惠券（设计稿的三个开关） -->
      <view class="card">
        <view class="deduct">
          <view class="grow">
            <view class="deduct__title">积分抵扣</view>
            <view class="deduct__sub">可用 {{points}} 积分，{{pointsRateText}}</view>
          </view>
          <switch checked="{{usePoints}}" color="{{themePrimary}}" bindchange="onTogglePoints" />
        </view>

        <view class="deduct">
          <view class="grow">
            <view class="deduct__title">次卡使用</view>
            <view class="deduct__sub" wx:if="{{hasCard}}">{{cardName}} · 剩余 {{cardRemain}} 次</view>
            <view class="deduct__sub" wx:else>暂无可用次卡</view>
          </view>
          <switch
            checked="{{useCard}}"
            color="{{themePrimary}}"
            disabled="{{!hasCard}}"
            bindchange="onToggleCard"
          />
        </view>

        <view class="deduct deduct--last" bindtap="onPickCoupon">
          <view class="grow">
            <view class="deduct__title">优惠券</view>
            <view class="deduct__sub">暂无可叠加优惠券</view>
          </view>
          <view class="deduct__pick">
            {{couponText}}
            <text class="deduct__arrow">›</text>
          </view>
        </view>
      </view>

      <!-- 优惠明细与实付 -->
      <view class="card">
        <view class="fee">
          <view class="text-sub">会员{{discountText}}优惠</view>
          <view class="fee__value">{{levelDiscountText}}元</view>
        </view>
        <view class="fee">
          <view class="text-sub">积分抵扣减</view>
          <view class="fee__value">{{pointsDiscountText}}元</view>
        </view>
        <view class="fee">
          <view class="text-sub">合计优惠</view>
          <view class="fee__value fee__value--strong">{{totalDiscountText}}元</view>
        </view>
        <view class="divider"></view>
        <view class="row-between">
          <view class="payable__label">实付</view>
          <view class="price">
            <text class="price__symbol">¥</text>
            <text class="price__yuan">{{payableText}}</text>
          </view>
        </view>
        <view class="price-note">
          此处为预估金额；会员折扣、积分抵扣与次卡核销由系统在提交后统一结算，最终以订单为准。
        </view>
      </view>

      <!-- 备注 -->
      <view class="card">
        <view class="section__title">想跟美甲师说的话</view>
        <textarea
          class="remark"
          value="{{remark}}"
          placeholder="比如：想要更短一点 / 对某款甲油过敏 / 第一次做"
          placeholder-class="remark__placeholder"
          maxlength="200"
          bindinput="onRemarkInput"
        />
      </view>

      <view wx:if="{{needBind}}" class="card card--tint bind-tip">
        <view class="grow">
          <view class="bind-tip__title">还需要绑定手机号</view>
          <view class="bind-tip__text">手机号用于匹配会员信息与到店联系，只用于本店服务。</view>
        </view>
      </view>
    </view>

    <view class="action-bar">
      <view class="grow">
        <view class="text-weak">实付</view>
        <view class="price">
          <text class="price__symbol">¥</text>
          <text class="price__yuan">{{payableText}}</text>
        </view>
      </view>
      <view class="btn {{submitting ? 'btn--disabled' : 'btn--primary'}} submit" bindtap="onSubmit">
        {{submitting ? '提交中…' : '提交预约'}}
      </view>
    </view>
  </block>
</view>
