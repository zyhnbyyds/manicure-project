<view class="page" style="{{themeStyle}}">
  <!-- 已选项目摘要（吸顶） -->
  <view class="summary">
    <view class="summary__row">
      <view class="grow">
        <view class="summary__label">已选款式</view>
        <view class="summary__items ellipsis">{{hasItems ? itemNames : '还没选款式'}}</view>
      </view>
      <view class="summary__right">
        <view class="summary__meta">{{durationText}} · ¥{{totalText}}</view>
        <view class="summary__change" bindtap="changeItems">改</view>
      </view>
    </view>
  </view>

  <view class="page-body">
    <view wx:if="{{loading}}" class="loading">正在叫美甲师们过来…</view>

    <view wx:elif="{{errorText}}" class="empty">
      <view class="empty__badge"><view class="empty__badge-dot"></view></view>
      <view class="empty__text">{{errorText}}</view>
    </view>

    <view wx:elif="{{staffs.length === 0}}" class="empty">
      <view class="empty__badge"><view class="empty__badge-dot"></view></view>
      <view class="empty__text">暂时没有可预约的美甲师</view>
    </view>

    <block wx:else>
      <view class="hint" wx:if="{{!hasItems}}">
        <text class="hint__emoji"></text>
        <text>先选款式，再挑美甲师会更准哦</text>
      </view>

      <view
        wx:for="{{staffs}}"
        wx:key="id"
        class="staff card card--press"
        data-id="{{item.id}}"
        bindtap="onPick"
      >
        <view class="staff__avatar thumb">
          <image wx:if="{{item.avatar}}" class="staff__img" src="{{item.avatar}}" mode="aspectFill" />
          <view wx:else class="image-placeholder staff__img">{{item.initial}}</view>
        </view>
        <view class="grow">
          <view class="staff__name">{{item.nickname}}</view>
          <view class="staff__bio">{{item.bio}}</view>
        </view>
        <view class="btn btn--soft btn--sm">选 TA</view>
      </view>
    </block>
  </view>
</view>
