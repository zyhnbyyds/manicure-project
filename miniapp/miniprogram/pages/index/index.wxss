/* 首页 */

.hero {
  position: relative;
  overflow: hidden;
  border-radius: var(--r-xl);
  padding: 40rpx 36rpx 32rpx;
  background: var(--c-gradient);
  box-shadow: 0 12rpx 32rpx var(--c-shadow);
}

.hero__head {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
}

.hero__hi {
  font-size: 26rpx;
  color: var(--c-text-sub);
}

.hero__title {
  margin-top: 8rpx;
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.hero__emoji {
  font-size: 84rpx;
  line-height: 1;
  margin-left: 16rpx;
}

.hero__meta {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  margin-top: 28rpx;
}

.hero__meta .mock-badge {
  margin-left: 16rpx;
}

/* 装饰气泡 */
.bubble--a {
  width: 140rpx;
  height: 140rpx;
  top: -40rpx;
  right: 90rpx;
}

.bubble--b {
  width: 70rpx;
  height: 70rpx;
  bottom: 20rpx;
  right: 30rpx;
}

.bubble--c {
  width: 44rpx;
  height: 44rpx;
  bottom: 90rpx;
  left: 20rpx;
}

/* 快捷入口 */
.quick {
  display: flex;
  justify-content: space-between;
  margin-top: 24rpx;
}

.quick__item {
  width: 23%;
  padding: 24rpx 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.quick__emoji {
  font-size: 48rpx;
  line-height: 1;
}

.quick__text {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--c-text-sub);
}

/* 两列网格：用 margin 而不是 flex gap（gap 在 iOS 老 WKWebView 上不生效） */
.grid {
  display: flex;
  flex-wrap: wrap;
}

.grid__cell {
  width: 48%;
  margin-bottom: 20rpx;
  padding: 20rpx;
}

.grid__cell:nth-child(odd) {
  margin-right: 4%;
}

.grid__thumb {
  width: 100%;
  height: 200rpx;
}

.grid__img {
  width: 100%;
  height: 100%;
  border-radius: var(--r-md);
}

.grid__name {
  margin-top: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.grid__meta {
  margin-top: 4rpx;
  margin-bottom: 10rpx;
}

/* 美甲师横向滚动 */
.staff-scroll {
  width: 100%;
  white-space: nowrap;
}

.staff-row {
  display: flex;
  padding-bottom: 8rpx;
}

.staff {
  width: 240rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
  padding: 24rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.staff:last-child {
  margin-right: 0;
}

.staff__avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
}

.staff__img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  font-size: 56rpx;
}

.staff__name {
  margin-top: 14rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.staff__bio {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--c-text-weak);
  text-align: center;
  white-space: normal;
}

.empty__action {
  margin-top: 24rpx;
}
