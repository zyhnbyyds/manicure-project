/* 首页 —— 严格对齐 docs/design.png 第 1 屏 */

/* ── 自定义导航栏 ─────────────────────────────────────────── */

.navbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: 28rpx;
  box-sizing: content-box;
}

.navbar__title {
  font-family: var(--font-serif);
  font-size: 40rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.navbar__actions {
  display: flex;
  align-items: center;
}

.navbar__icon {
  width: 48rpx;
  height: 48rpx;
  margin-left: 30rpx;
}

/* ── 头图 ─────────────────────────────────────────────────── */

.hero {
  position: relative;
  margin: 0 28rpx;
  height: 408rpx;
  border-radius: var(--r-lg);
  overflow: hidden;
}

.hero__img {
  width: 100%;
  height: 100%;
}

.hero__mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 240rpx;
  background: linear-gradient(
    to top,
    rgba(45, 34, 30, 0.55) 0%,
    rgba(45, 34, 30, 0) 100%
  );
}

.hero__text {
  position: absolute;
  left: 36rpx;
  bottom: 30rpx;
}

.hero__title {
  font-family: var(--font-serif);
  font-size: 48rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 3rpx;
}

.hero__sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.88);
}

/* ── 快捷入口 ─────────────────────────────────────────────── */

.quick {
  display: flex;
  padding: 24rpx 28rpx 0;
}

.quick__item {
  flex: 1;
  padding: 22rpx 0 18rpx;
  background: var(--c-card);
  border-radius: var(--r-md);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.quick__item + .quick__item {
  margin-left: 16rpx;
}

.quick__icon {
  width: 48rpx;
  height: 48rpx;
}

.quick__label {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--c-text-sub);
}

/* ── 区块标题 ─────────────────────────────────────────────── */

.section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 30rpx 28rpx 0;
}

.section__more {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: var(--c-text-weak);
}

.section__arrow {
  width: 24rpx;
  height: 24rpx;
  margin-left: 4rpx;
}

/* ── 人气款式（横向滑动，一屏露出约 2.5 张）────────────────── */

.popular {
  width: 100%;
  white-space: nowrap;
  margin-top: 20rpx;
}

.popular__row {
  display: flex;
  padding: 0 28rpx;
}

.popular__card {
  width: 284rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
  background: var(--c-card);
  border-radius: var(--r-md);
  overflow: hidden;
}

.popular__card:last-child {
  margin-right: 0;
}

.popular__photo {
  width: 100%;
  height: 166rpx;
  display: block;
}

.popular__body {
  padding: 16rpx 18rpx 20rpx;
}

.popular__name {
  font-family: var(--font-serif);
  font-size: 28rpx;
  font-weight: 600;
}

.popular__meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--c-text-weak);
}

.popular__price {
  margin-top: 10rpx;
}

/* ── 美甲师 ───────────────────────────────────────────────── */

.staffs {
  display: flex;
  padding: 18rpx 28rpx 0;
}

.staffs__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 圆环与头像分两层：外层画环，内层裁圆，避免图片圆角与描边打架 */
.staffs__ring {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  border: 3rpx solid var(--c-border);
  padding: 4rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 设计稿第一位美甲师用主色圆环突出 */
.staffs__ring.is-featured {
  border-color: var(--c-primary);
}

.staffs__avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.staffs__name {
  margin-top: 14rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.staffs__bio {
  margin-top: 4rpx;
  max-width: 150rpx;
  font-size: 20rpx;
  color: var(--c-text-weak);
}
