<view class="page" style="{{themeStyle}}">
  <!-- 搜索（设计稿：胶囊搜索框 + 放大镜） -->
  <view class="search">
    <view class="search__box">
      <image class="search__icon" src="{{icons.search}}" mode="aspectFit" />
      <input
        class="search__input"
        value="{{keyword}}"
        placeholder="搜款式名 / 风格"
        placeholder-class="search__placeholder"
        confirm-type="search"
        bindinput="onSearchInput"
      />
      <view wx:if="{{keyword}}" class="search__clear" bindtap="onSearchClear">×</view>
    </view>
  </view>

  <!-- 分类 + 排序入口 -->
  <view class="filters">
    <scroll-view class="filters__scroll" scroll-x enable-flex show-scrollbar="{{false}}">
      <view class="filters__row">
        <view
          wx:for="{{categories}}"
          wx:key="*this"
          class="chip {{activeCategory === item ? 'is-active' : ''}}"
          data-name="{{item}}"
          bindtap="onCategory"
        >
          {{item}}
        </view>
      </view>
    </scroll-view>
    <view class="filters__sort" bindtap="onFilter">
      <image class="filters__sort-icon" src="{{icons.funnel}}" mode="aspectFit" />
      <view class="filters__dot"></view>
    </view>
  </view>

  <view class="page-body">
    <!-- 骨架屏（batch3）：设计稿用的是色块骨架，不是一个转圈 -->
    <block wx:if="{{loading}}">
      <view wx:for="{{skeletonRows}}" wx:key="*this" class="card skeleton-card">
        <view class="skeleton skeleton-card__photo"></view>
        <view class="skeleton-card__body">
          <view class="skeleton skeleton-card__line skeleton-card__line--title"></view>
          <view class="skeleton skeleton-card__line skeleton-card__line--meta"></view>
          <view class="skeleton skeleton-card__line skeleton-card__line--price"></view>
        </view>
      </view>
    </block>

    <!-- 错误态（batch3：网络连接失败 + 重试） -->
    <view wx:elif="{{errorText}}" class="empty anim-pop">
      <image class="empty__icon" src="{{icons.search}}" mode="aspectFit" />
      <view class="empty__text">{{errorText}}</view>
      <view class="empty__hint">请检查网络后重试</view>
      <view class="btn btn--primary btn--sm empty__action" bindtap="onRetry">重新加载</view>
    </view>

    <view wx:elif="{{items.length === 0}}" class="empty anim-pop">
      <view class="empty__text">没有找到相关款式</view>
      <view class="empty__hint">换个关键词或分类试试～</view>
    </view>

    <block wx:else>
      <!-- 整块入场：骨架屏 → 内容只播一次，列表本身不逐项 stagger（13 项会拖到 0.6s，反而显得卡） -->
      <view class="anim-rise">
        <view
          wx:for="{{items}}"
          wx:key="id"
          class="card list-card press {{item.checked ? 'is-checked' : ''}}"
        >
          <!-- 左：作品照（点击进详情） -->
          <view class="list-card__photo thumb" data-id="{{item.id}}" bindtap="openDetail">
            <image class="list-card__img" src="{{item.imageResolved}}" mode="aspectFill" />
          </view>

          <!-- 右：名称 / 时长分类 / 价格 -->
          <view class="list-card__info" data-id="{{item.id}}" bindtap="openDetail">
            <view class="list-card__name ellipsis">{{item.name}}</view>
            <view class="list-card__meta ellipsis">{{item.durationText}} · {{item.category}}</view>
            <view class="price list-card__price">
              <text class="price__symbol">¥</text>
              <text class="price__yuan">{{item.priceYuan}}</text>
            </view>
          </view>

          <!-- 右上：圆形加号（未选）/ 对勾（已选） -->
          <view
            class="list-card__add {{item.checked ? 'is-checked' : ''}}"
            data-id="{{item.id}}"
            bindtap="toggle"
          >
            <image
              class="list-card__add-icon"
              src="{{item.checked ? iconsWhite.check : icons.plus}}"
              mode="aspectFit"
            />
          </view>
        </view>
      </view>
    </block>
  </view>

  <!-- 底部结算条：只在选了项目后出现（设计稿即如此）；出现时从下方轻轻浮起 -->
  <view wx:if="{{selectedCount > 0}}" class="action-bar anim-rise">
    <view class="grow">
      <view class="action-bar__sum">已选 {{selectedCount}} 项 · {{durationText}}</view>
      <view class="action-bar__total">
        合计 <text class="action-bar__amount">¥{{totalText}}</text>
      </view>
    </view>
    <view class="btn btn--primary" bindtap="goNext">下一步</view>
  </view>
</view>
