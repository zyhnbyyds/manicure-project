/* 款式库 —— 严格对齐 docs/design.png 第 2 屏（含 batch3 骨架屏/错误态、batch5 下拉刷新） */

/* ── 吸顶头（搜索 + 分类）───────────────────────────────────── */

/*
 * 定位/背景由 app.wxss 的 `.sticky-head` 提供（三个列表页共用一套）。
 * 这里补一条**极淡的下边线**：吸顶后列表从下面穿过，没有分隔会糊在一起；
 * 色值贴近页面底色，未滚动时几乎看不出来（设计稿本来没有这条线）。
 */
.head {
  border-bottom: 2rpx solid var(--c-border);
}

/*
 * 底部结算条是 `position: fixed` 的：出现时给列表补 200rpx 内边距，
 * 否则最后一张卡永远滚不到结算条上方（另外 12 个带 `.action-bar` 的页面都是这么处理的，
 * 这里因为它**是有条件出现**的，所以跟着 `selectedCount` 走，没选项目时不留空白）。
 */
.page-body.has-action-bar {
  padding-bottom: 200rpx;
}

/* ── 搜索 ─────────────────────────────────────────────────── */

/* ── 搜索 ─────────────────────────────────────────────────── */

.search {
  padding: 8rpx 28rpx 0;
}

.search__box {
  display: flex;
  align-items: center;
  height: 76rpx;
  padding: 0 26rpx;
  background: var(--c-card);
  border-radius: var(--r-pill);
  border: 2rpx solid var(--c-border);
}

.search__icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  margin-right: 14rpx;
}

.search__input {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: var(--c-text);
}

.search__placeholder {
  color: var(--c-text-weak);
  font-size: 26rpx;
}

.search__clear {
  width: 40rpx;
  text-align: center;
  color: var(--c-text-weak);
  font-size: 36rpx;
  line-height: 1;
}

/* ── 分类 + 排序 ──────────────────────────────────────────── */

.filters {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx 8rpx;
}

.filters__scroll {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}

.filters__row {
  display: flex;
}

/* 选中：主色实心 + 白字（设计稿「全部」即如此） */
.filters__sort {
  position: relative;
  width: 60rpx;
  height: 60rpx;
  margin-left: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.filters__sort-icon {
  width: 40rpx;
  height: 40rpx;
}

/* 设计稿的漏斗右上角有一个小红点 */
.filters__dot {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #d9483f;
}

/* ── 列表卡片 ─────────────────────────────────────────────── */

.list-card {
  position: relative;
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
  padding: 20rpx;
  /* 选中态描边与卡片底色都做过渡，点选时不会「啪」地跳一下 */
  transition: border-color var(--dur-fast) var(--ease-out),
    box-shadow var(--dur-fast) var(--ease-out),
    transform var(--dur-fast) var(--ease-out);
}

/* 选中：主色描边 + 主色柔光（只加描边太「干」，柔光让选中更明确） */
.list-card.is-checked {
  border: 2rpx solid var(--c-primary);
  box-shadow: 0 8rpx 24rpx var(--c-primary-soft);
}

.list-card__photo {
  width: 210rpx;
  height: 210rpx;
  flex-shrink: 0;
}

.list-card__img {
  width: 100%;
  height: 100%;
  border-radius: var(--r-md);
}

.list-card__info {
  flex: 1;
  min-width: 0;
  padding: 0 20rpx 0 24rpx;
  /* 给右上角圆形按钮让位 */
  padding-right: 76rpx;
}

.list-card__name {
  font-family: var(--font-serif);
  font-size: 32rpx;
  font-weight: 600;
}

.list-card__meta {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--c-text-weak);
}

/* 设计稿的价格在卡片右下区域，字号明显大于辅助文字 */
.list-card__price {
  margin-top: 22rpx;
}

/* 圆形加号 / 对勾 */
.list-card__add {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  border: 2rpx solid var(--c-border);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color var(--dur-fast) var(--ease-out),
    border-color var(--dur-fast) var(--ease-out);
}

/* 选中的瞬间弹一下（class 变化才会重播，不会每次 setData 都抖） */
.list-card__add.is-checked {
  background: var(--c-primary);
  border-color: var(--c-primary);
  animation: add-pop var(--dur-slow) var(--ease-back);
}

@keyframes add-pop {
  0% {
    transform: scale(0.7);
  }
  60% {
    transform: scale(1.12);
  }
  100% {
    transform: scale(1);
  }
}

.list-card__add-icon {
  width: 30rpx;
  height: 30rpx;
}

/* ── 骨架屏（batch3）──────────────────────────────────────── */

.skeleton-card {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
  padding: 20rpx;
}

.skeleton-card__photo {
  width: 210rpx;
  height: 210rpx;
  flex-shrink: 0;
  border-radius: var(--r-md);
}

.skeleton-card__body {
  flex: 1;
  padding-left: 24rpx;
}

.skeleton-card__line {
  height: 28rpx;
  border-radius: var(--r-sm);
}

.skeleton-card__line--title {
  width: 60%;
}

.skeleton-card__line--meta {
  width: 40%;
  margin-top: 20rpx;
}

.skeleton-card__line--price {
  width: 30%;
  height: 36rpx;
  margin-top: 34rpx;
}

/* ── 底部结算条 ───────────────────────────────────────────── */

.action-bar__sum {
  font-size: 22rpx;
  color: var(--c-text-sub);
}

.action-bar__total {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--c-text-sub);
}

.action-bar__amount {
  font-family: var(--font-serif);
  font-size: 36rpx;
  font-weight: 600;
  color: var(--c-primary);
}

.empty__icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

