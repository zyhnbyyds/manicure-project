<view class="page pay" style="{{themeStyle}}">
  <!-- 收银台必须先有身份：未绑定时引导，而不是显示加载失败 -->
  <view wx:if="{{guest}}" class="empty">
    <view class="empty__text">{{loggedIn ? '绑定手机号后才能支付' : '登录后才能支付'}}</view>
    <view class="empty__hint">支付需要确认订单归属，绑定手机号即可继续</view>
    <view class="btn btn--primary empty__action" bindtap="onGuestLogin">去登录 / 绑定</view>
  </view>

  <view wx:elif="{{loading}}" class="loading">正在读取订单…</view>

  <view wx:elif="{{errorText}}" class="empty">
    <view class="empty__text">{{errorText}}</view>
    <view class="btn btn--primary btn--sm empty__action" bindtap="goBookings">看我的预约</view>
  </view>

  <block wx:else>
    <view class="page-body pay-body">
      <!-- 待付金额：整页最重的视觉 -->
      <view class="amount">
        <view class="amount__label">待付金额</view>
        <view class="amount__value">
          <text class="amount__number">{{dueText}}</text>
          <text class="amount__unit">元</text>
        </view>
      </view>

      <!-- 订单摘要（点击回订单列表） -->
      <view class="card order" bindtap="onOrderTap">
        <view class="grow">
          <view class="order__name ellipsis">{{booking.itemNames}}</view>
          <view class="order__meta">{{booking.dateText}} {{booking.timeText}} · {{booking.staffName}}</view>
        </view>
        <text class="order__arrow">›</text>
      </view>

      <!-- 支付方式 -->
      <view class="section">
        <view class="section__title">选择支付方式</view>
      </view>
      <view class="card methods">
        <view
          wx:for="{{methods}}"
          wx:key="key"
          class="method {{item.enabled ? '' : 'is-disabled'}} {{activeMethod === item.key ? 'is-active' : ''}}"
          data-key="{{item.key}}"
          bindtap="onPickMethod"
        >
          <view class="grow">
            <view class="method__title">{{item.title}}</view>
            <view wx:if="{{item.sub}}" class="method__sub ellipsis">{{item.sub}}</view>
          </view>
          <!-- 单选圈：纯 CSS，避免为一个圆点引入图标 -->
          <view class="radio {{activeMethod === item.key ? 'is-checked' : ''}}">
            <view class="radio__dot"></view>
          </view>
        </view>
      </view>

      <view class="tips">余额不足时可组合支付，支持「余额 + 微信支付」。</view>
    </view>

    <view class="action-bar">
      <view class="btn btn--primary btn--block" bindtap="onConfirm">
        {{booking.dueText ? '确认支付 ' + dueText + ' 元' : '确认支付'}}
      </view>
    </view>
  </block>
</view>
