/* 主题设置 —— 设计稿没有这一页，用设计稿的语言装功能 */

.theme-body {
  padding-bottom: 60rpx;
}

/* ── 当前主题 ─────────────────────────────────────────────── */

.current {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-radius: var(--r-lg);
  background: var(--c-gradient);
}

.current__dot {
  width: 72rpx;
  height: 72rpx;
  margin-right: 22rpx;
  border-radius: 50%;
  background: var(--c-primary);
  flex-shrink: 0;
}

.current__label {
  font-size: 21rpx;
  color: var(--c-text-sub);
}

.current__name {
  margin-top: 6rpx;
  font-family: var(--font-serif);
  font-size: 36rpx;
  font-weight: 600;
}

.current__tag {
  height: 40rpx;
  line-height: 40rpx;
  padding: 0 18rpx;
  border-radius: var(--r-pill);
  background: rgba(255, 255, 255, 0.7);
  color: var(--c-primary-deep);
  font-size: 20rpx;
}

/* ── 预览 ─────────────────────────────────────────────────── */

.preview__title {
  font-family: var(--font-serif);
  font-size: 32rpx;
  font-weight: 600;
}

.preview__meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--c-text-weak);
}

.preview__tags {
  display: flex;
  margin-top: 18rpx;
}

.tag-chip {
  height: 48rpx;
  line-height: 48rpx;
  padding: 0 20rpx;
  margin-right: 14rpx;
  border-radius: var(--r-pill);
  background: var(--c-chip);
  color: var(--c-text-sub);
  font-size: 21rpx;
}

.preview__btn {
  margin-top: 18rpx;
}

/* ── 预设主题：两列 ───────────────────────────────────────── */

.presets {
  display: flex;
  flex-wrap: wrap;
}

.preset {
  width: 48%;
  margin-bottom: 20rpx;
  padding: 22rpx 20rpx;
  background: var(--c-card);
  border-radius: var(--r-md);
  border: 2rpx solid transparent;
  box-sizing: border-box;
}

/* 用 margin 而非 flex gap（iOS 老版本 WKWebView 不支持 gap） */
.preset:nth-child(odd) {
  margin-right: 4%;
}

.preset.is-active {
  border-color: var(--c-primary);
  background: var(--c-primary-soft);
}

.preset__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 用色板圆点代替 emoji 表达主题差异 */
.preset__dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
}

.preset__check {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--c-primary);
}

.preset__name {
  margin-top: 14rpx;
  font-family: var(--font-serif);
  font-size: 28rpx;
  font-weight: 600;
}

.preset__desc {
  margin-top: 6rpx;
  min-height: 56rpx;
  font-size: 20rpx;
  line-height: 1.4;
  color: var(--c-text-weak);
}

.preset__swatch {
  display: flex;
  margin-top: 12rpx;
}

.preset__mini {
  width: 28rpx;
  height: 28rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(0, 0, 0, 0.04);
}

.preset__mini--bg {
  border: 2rpx solid var(--c-border);
}

/* ── 自定义色板 ───────────────────────────────────────────── */

.palette {
  display: flex;
  flex-wrap: wrap;
}

.palette__item {
  width: 88rpx;
  height: 88rpx;
  margin: 0 18rpx 18rpx 0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid transparent;
  box-sizing: border-box;
}

.palette__item.is-active {
  border-color: var(--c-text);
}

.palette__check {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
}

.palette__hint {
  margin-top: 6rpx;
  font-size: 21rpx;
  line-height: 1.6;
  color: var(--c-text-weak);
}

.reset {
  margin-top: 36rpx;
}
